<% content_for :page_title, t("ui.auth.login_title") %>

<section class="w-full max-w-md">
  <div class="<%= card_class %> p-6">
    <div class="mb-6">
      <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-slate-900 text-sm font-bold text-white">A</div>
      <h1 class="text-2xl font-semibold text-slate-950"><%= t("ui.auth.login_heading") %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= t("ui.auth.login_subtitle") %></p>
    </div>

    <%= form_with url: login_path, class: "space-y-4", data: { turbo: false } do |form| %>
      <div>
        <%= form.label :email, class: label_class %>
        <%= form.email_field :email, class: field_class, required: true %>
      </div>
      <div>
        <%= form.label :password, class: label_class %>
        <%= form.password_field :password, class: field_class, required: true %>
      </div>
      <%= form.submit t("ui.auth.login_submit"), class: "#{primary_button_class} w-full" %>
    <% end %>

    <div class="mt-5 border-t border-slate-100 pt-5">
      <p class="text-center text-sm text-slate-500"><%= t("ui.auth.missing_confirmation") %></p>
      <%= form_with url: resend_verification_email_path, class: "mt-3 flex gap-2" do |form| %>
        <%= form.email_field :email, class: field_class, placeholder: t("ui.auth.email_placeholder"), required: true %>
        <%= form.submit t("ui.auth.resend"), class: secondary_button_class %>
      <% end %>
    </div>

    <p class="mt-5 text-center text-sm text-slate-500"><%= t("ui.auth.new_to_ayla") %> <%= link_to t("ui.auth.create_account"), signup_path, class: "font-semibold text-slate-950" %></p>
  </div>
</section>
