<% content_for :page_title, "Editar FAQ" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Volver a la propiedad", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Editar FAQ</h2>
  </div>
  <%= render "form", property: @property, faq: @faq %>
  <div class="mt-4 text-right">
    <%= button_to "Eliminar FAQ", property_faq_path(@property, @faq), method: :delete, class: "text-sm font-semibold text-rose-600 hover:text-rose-700" %>
  </div>
</div>
