<% content_for :page_title, "#{@property.display_name} FAQs" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "Back to property", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
      <h2 class="mt-3 text-xl font-semibold text-slate-950">FAQs</h2>
    </div>
    <%= link_to "Add FAQ", new_property_faq_path(@property), class: primary_button_class %>
  </div>

  <div class="<%= card_class %> divide-y divide-slate-100 overflow-hidden">
    <% @faqs.each do |faq| %>
      <div class="px-5 py-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-medium text-slate-950"><%= faq.question %></p>
            <p class="mt-2 text-sm text-slate-600"><%= faq.answer %></p>
          </div>
          <%= link_to "Edit", edit_property_faq_path(@property, faq), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
