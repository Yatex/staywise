<% content_for :page_title, "New FAQ" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Back to property", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Add FAQ</h2>
  </div>
  <%= render "shared/source_selector",
    sources: @source_faqs,
    url: new_property_faq_path(@property),
    title: "Reuse an FAQ",
    description: "Start with a question and answer already used on another property.",
    label: ->(faq) { "#{faq.property.display_name} - #{truncate(faq.question, length: 60)}" } %>
  <%= render "form", property: @property, faq: @faq %>
</div>
