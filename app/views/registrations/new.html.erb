<% content_for :page_title, t("ui.auth.signup_title") %>

<section class="w-full max-w-md">
  <div class="<%= card_class %> p-6">
    <div class="mb-6">
      <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-slate-900 text-sm font-bold text-white">A</div>
      <h1 class="text-2xl font-semibold text-slate-950"><%= t("ui.auth.signup_heading") %></h1>
      <p class="mt-2 text-sm text-slate-500"><%= t("ui.auth.signup_subtitle") %></p>
    </div>

    <% if @signup_error.present? %>
      <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"><%= @signup_error %></div>
    <% end %>

    <%= form_with scope: :registration, url: signup_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :account_name, t("ui.auth.organization_name"), class: label_class %>
        <%= form.text_field :account_name, value: @account.name, class: field_class, required: true %>
      </div>
      <div>
        <%= form.label :name, t("ui.auth.your_name"), class: label_class %>
        <%= form.text_field :name, value: @user.name, class: field_class, required: true %>
      </div>
      <div>
        <%= form.label :email, class: label_class %>
        <%= form.email_field :email, value: @user.email, class: field_class, required: true %>
      </div>
      <div>
        <%= form.label :password, class: label_class %>
        <%= form.password_field :password, class: field_class, required: true, minlength: 8 %>
      </div>
      <div>
        <%= form.label :password_confirmation, class: label_class %>
        <%= form.password_field :password_confirmation, class: field_class, required: true, minlength: 8 %>
      </div>
      <label class="flex gap-3 rounded-lg border border-slate-200 bg-white p-3 text-sm text-slate-600">
        <%= form.check_box :legal_acceptance,
          { checked: ActiveModel::Type::Boolean.new.cast(params.dig(:registration, :legal_acceptance)), required: true, class: "mt-1 h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900" },
          "1",
          "0" %>
        <span>
          <%= t("ui.auth.legal_prefix") %>
          <%= link_to t("ui.auth.terms"), terms_path, target: "_blank", rel: "noopener", class: "font-semibold text-slate-950 underline decoration-slate-300 underline-offset-2" %>
          <%= t("ui.auth.legal_connector") %>
          <%= link_to t("ui.auth.privacy"), privacy_path, target: "_blank", rel: "noopener", class: "font-semibold text-slate-950 underline decoration-slate-300 underline-offset-2" %>.
        </span>
      </label>
      <%= form.submit t("ui.auth.signup_submit"), class: "#{primary_button_class} w-full" %>
    <% end %>

    <p class="mt-5 text-center text-sm text-slate-500"><%= t("ui.auth.already_have_account") %> <%= link_to t("ui.auth.login_submit"), login_path, class: "font-semibold text-slate-950" %></p>
  </div>
</section>
