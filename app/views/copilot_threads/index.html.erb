<% content_for :page_title, "Historial" %>

<div class="mx-auto max-w-5xl space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-2xl font-semibold text-slate-950">Tus conversaciones con Ayla</h2>
      <p class="mt-1 text-sm text-slate-500">Retomá una consulta anterior o empezá una nueva para otra propiedad.</p>
    </div>
    <%= link_to "Nueva consulta", new_copilot_thread_path, class: primary_button_class %>
  </div>

  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <% @threads.each do |thread| %>
      <%= link_to copilot_thread_path(thread), class: "block border-b border-slate-100 px-5 py-4 transition last:border-0 hover:bg-slate-50" do %>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-semibold text-slate-950"><%= thread.display_title %></p>
            <p class="mt-1 text-sm text-slate-500"><%= thread.property.display_name %> · <%= thread.copilot_messages.size %> mensajes</p>
          </div>
          <time class="shrink-0 text-xs text-slate-400"><%= l(thread.last_message_at || thread.created_at, format: :short) %></time>
        </div>
      <% end %>
    <% end %>
    <% if @threads.blank? %>
      <div class="px-6 py-12 text-center">
        <p class="font-medium text-slate-800">Todavía no hiciste consultas.</p>
        <p class="mt-1 text-sm text-slate-500">Ayla puede ayudarte a redactar la próxima respuesta.</p>
      </div>
    <% end %>
  </div>
</div>
