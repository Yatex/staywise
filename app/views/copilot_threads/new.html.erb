<% content_for :page_title, "Nueva consulta" %>

<div class="mx-auto flex min-h-[calc(100vh-10rem)] max-w-3xl items-center py-4 sm:py-8">
  <%= form_with url: copilot_threads_path, class: "w-full space-y-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8" do |form| %>
    <div class="text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-900 text-white"><%= sidebar_icon(:copilot) %></div>
      <h2 class="mt-4 text-2xl font-semibold text-slate-950">¿Sobre qué propiedad querés consultar?</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-500">Elegí la propiedad y pegá el mensaje tal como lo recibiste. Ayla te propondrá una respuesta para revisar y copiar.</p>
    </div>

    <div>
      <%= form.label :property_id, "Propiedad", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.select :property_id,
        options_from_collection_for_select(@properties, :id, :display_name, @selected_property_id),
        { prompt: "Seleccioná una propiedad" },
        required: true,
        class: "mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-slate-900 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :guest_message, "Mensaje del huésped", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.text_area :guest_message, rows: 7, required: true, autofocus: @selected_property_id.present?, placeholder: "Pegá acá el mensaje que recibiste del huésped", class: "mt-2 w-full resize-y rounded-2xl border border-slate-300 px-4 py-4 text-base leading-7 text-slate-900 shadow-sm focus:border-slate-500 focus:ring-slate-500" %>
    </div>

    <div>
      <%= form.label :host_context, "Contexto adicional (opcional)", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.text_area :host_context, rows: 2, placeholder: "Ej.: hicieron check-in hoy.", class: "mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900" %>
    </div>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", copilot_threads_path, class: "text-center #{secondary_button_class}" %>
      <%= form.submit "Consultar a Ayla", class: "w-full sm:w-auto #{primary_button_class}" %>
    </div>
  <% end %>
</div>
