<% content_for :page_title, @thread.display_title %>

<div class="mx-auto max-w-4xl">
  <header class="mb-6 flex flex-col gap-3 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <%= link_to "← Historial", copilot_threads_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
      <h2 class="mt-3 truncate text-xl font-semibold text-slate-950"><%= @thread.display_title %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= @thread.property.display_name %></p>
    </div>
    <p class="max-w-sm text-sm text-slate-500 sm:text-right">Ayla prepara el texto para que vos lo revises y copies. Nada se envía automáticamente.</p>
  </header>

  <aside class="mb-7 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-4 sm:p-5" aria-label="Hablar con Ayla por WhatsApp">
    <%= render "shared/whatsapp_copilot_access" %>
  </aside>

  <section class="space-y-7" aria-label="Conversación con Ayla">
    <% @messages.each_with_index do |message, index| %>
      <% if message.role == "host" %>
        <article class="ml-auto max-w-2xl" data-message-role="host">
          <div class="mb-2 flex items-center justify-end gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
            <span><%= index.zero? ? "Vos pegaste" : "Vos escribiste" %></span>
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-800 text-[11px] text-white"><%= (current_user.name.presence || current_user.email).first.upcase %></span>
          </div>
          <div class="rounded-2xl rounded-tr-md bg-slate-200 px-5 py-4 text-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= index.zero? ? "Mensaje original del huésped" : "Mensaje o seguimiento para Ayla" %></p>
            <p class="mt-2 whitespace-pre-wrap leading-7"><%= message.content %></p>
            <% if message.host_context.present? %>
              <div class="mt-4 border-t border-slate-300 pt-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Contexto agregado por vos</p>
                <p class="mt-1 whitespace-pre-wrap text-sm leading-6"><%= message.host_context %></p>
              </div>
            <% end %>
          </div>
        </article>
      <% else %>
        <% result = message.structured_content.to_h %>
        <article class="mr-auto max-w-3xl" data-message-role="assistant">
          <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-900 text-white"><%= sidebar_icon(:copilot) %></span>
            <span>Ayla</span>
          </div>
          <div class="overflow-hidden rounded-2xl rounded-tl-md border border-slate-200 bg-white shadow-sm">
            <div class="grid gap-5 border-b border-slate-100 p-5 sm:grid-cols-2">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Entendí que pregunta</p>
                <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-800"><%= result["guest_question_es"] %></p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Respuesta</p>
                <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-800"><%= result["answer_summary_es"] %></p>
              </div>
              <div class="sm:col-span-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Idioma</p>
                <p class="mt-1 text-sm font-semibold text-slate-800"><%= language_label(result["detected_language"]) %></p>
              </div>
            </div>

            <% if result["missing_information"] %>
              <div class="border-l-4 border-amber-400 bg-amber-50 p-5">
                <p class="font-semibold text-amber-950">No tengo suficiente información para responder esto con seguridad.</p>
                <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-amber-900"><%= result["clarifying_question_es"] %></p>
                <% if result["clarifying_question_guest"].present? %>
                  <div class="mt-4 rounded-xl border border-amber-200 bg-white p-4" data-controller="clipboard" data-clipboard-text-value="<%= result["clarifying_question_guest"] %>">
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Pregunta lista para el huésped</p>
                    <p class="mt-2 whitespace-pre-wrap leading-7 text-slate-950"><%= result["clarifying_question_guest"] %></p>
                    <button type="button" class="mt-4 rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100" data-action="clipboard#copyText">Copiar pregunta</button>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="bg-slate-950 p-5 text-white sm:p-6" data-controller="clipboard" data-clipboard-text-value="<%= result["guest_reply"] %>">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-widest text-emerald-300">Mensaje para enviar</p>
                    <p class="mt-3 whitespace-pre-wrap text-lg leading-8"><%= result["guest_reply"] %></p>
                  </div>
                  <button type="button" class="shrink-0 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-950 shadow-sm hover:bg-slate-100" data-action="clipboard#copyText">Copiar respuesta</button>
                </div>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    <% end %>
  </section>

  <% if @latest_run&.status == "failed" %>
    <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800">No pudimos preparar la última respuesta. Podés intentarlo nuevamente.</div>
  <% end %>

  <section class="sticky bottom-0 z-10 mt-8 border-t border-slate-200 bg-slate-50/95 py-4 backdrop-blur" aria-label="Continuar consulta">
    <%= form_with url: copilot_thread_messages_path(@thread), class: "rounded-2xl border border-slate-300 bg-white p-3 shadow-lg" do |form| %>
      <%= form.label :guest_message, "Continuar con Ayla", class: "sr-only" %>
      <%= form.text_area :guest_message, rows: 3, required: true, placeholder: "Escribí un seguimiento, por ejemplo: Me respondió que el código no funciona", class: "w-full resize-none border-0 px-2 py-2 text-base leading-7 text-slate-900 shadow-none focus:ring-0" %>
      <div class="mt-2 flex flex-col gap-3 border-t border-slate-100 pt-3 sm:flex-row sm:items-end">
        <div class="flex-1">
          <%= form.label :host_context, "Contexto adicional (opcional)", class: "sr-only" %>
          <%= form.text_field :host_context, placeholder: "Contexto adicional (opcional)", class: "w-full rounded-lg border-slate-200 px-3 py-2 text-sm text-slate-700" %>
        </div>
        <%= form.submit "Consultar a Ayla", class: "w-full sm:w-auto #{primary_button_class}" %>
      </div>
    <% end %>
  </section>
</div>
