<% content_for :page_title, "Suscripciones" %>

<div class="space-y-6">
  <section class="<%= card_class %> p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold text-slate-950">Suscripción</h2>
      </div>
      <span class="w-fit rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@subscription&.status) %>"><%= @subscription&.trialing? ? "Prueba gratis" : ((@subscription ? enum_label(@subscription.status) : nil) || "Incompleta") %></span>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-sm text-slate-500">Estado actual</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= subscription_commercial_label(@subscription) %></p>
        <% if @subscription&.trialing? %>
          <p class="mt-1 text-xs text-slate-500">Todavía no hay una suscripción paga activa.</p>
        <% end %>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-sm text-slate-500">Límite de propiedades</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= current_account.effective_property_limit %></p>
        <% if current_account.property_limit_override.present? || current_account.property_limit_override == 0 %>
          <p class="mt-1 text-xs text-slate-500">Límite especial aplicado: <%= current_account.property_limit_override %> propiedades.</p>
        <% end %>
      </div>
      <div class="rounded-lg bg-slate-50 p-4">
        <p class="text-sm text-slate-500"><%= @subscription&.trialing? ? "Fin de prueba" : "Propiedades usadas" %></p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <% if @subscription&.trialing? %>
            <%= @subscription.trial_ends_on&.to_fs(:long) || "Sin configurar" %>
          <% else %>
            <%= current_account.properties.count %>
          <% end %>
        </p>
        <% if @subscription&.trialing? && trial_days_label(@subscription).present? %>
          <p class="mt-1 text-xs text-slate-500"><%= trial_days_label(@subscription).capitalize %>.</p>
        <% end %>
      </div>
    </div>
    <div class="mt-5">
      <%= button_to "Abrir portal de suscripción", portal_subscription_path, method: :post, class: secondary_button_class, form: { data: { turbo: false } } %>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
    <% @plans.each do |plan| %>
      <div class="<%= card_class %> flex flex-col p-5">
        <h3 class="text-lg font-semibold text-slate-950"><%= plan[:name] %></h3>
        <p class="mt-3 text-3xl font-semibold text-slate-950"><%= plan[:price] %></p>
        <p class="mt-2 text-sm text-slate-500"><%= plan[:description] %></p>
        <p class="mt-auto pt-4 text-sm font-semibold text-slate-700"><%= plan[:limit] %></p>
        <div class="mt-6">
          <%= button_to "Elegir #{plan[:name]}", checkout_subscription_path(plan: plan[:id]), method: :post, class: "#{primary_button_class} w-full", form: { data: { turbo: false } } %>
        </div>
      </div>
    <% end %>
  </section>
</div>
