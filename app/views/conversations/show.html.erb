<% content_for :page_title, "Conversación" %>

<div class="grid gap-6 xl:grid-cols-[1fr_340px]" data-controller="conversation-refresh" data-conversation-refresh-url-value="<%= conversation_path(@conversation) %>" data-conversation-refresh-interval-value="5000">
  <section class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <%= link_to "Volver a conversaciones", conversations_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-950"><%= conversation_display_title(@conversation) %></h2>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span class="<%= property_tag_class %>"><%= @conversation.property.display_name %></span>
            <span class="text-sm text-slate-500">WhatsApp</span>
          </div>
        </div>
        <span data-conversation-refresh-target="status" class="w-fit rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@conversation.status) %>"><%= enum_label(@conversation.status) %></span>
      </div>
    </div>

    <div class="space-y-4 bg-slate-50 px-5 py-6" data-conversation-refresh-target="messages">
      <% @messages.each do |message| %>
        <div id="message-<%= message.id %>" class="flex <%= message.sender == "guest" ? "justify-start" : "justify-end" %>">
          <div class="<%= message.sender == "guest" ? "border-slate-200 bg-white text-slate-800" : "border-slate-900 bg-slate-900 text-white" %> max-w-[760px] rounded-xl border px-4 py-3 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide <%= message.sender == "guest" ? "text-slate-400" : "text-slate-300" %>"><%= enum_label(message.sender) %></p>
            <p class="mt-2 whitespace-pre-line text-sm leading-6"><%= message.body %></p>
            <p class="mt-3 text-xs <%= message.sender == "guest" ? "text-slate-400" : "text-slate-300" %>"><%= local_datetime(message.created_at) %></p>
            <% if message.sender != "guest" && (message.metadata["delivery_status"].present? || message.metadata["provider_status"].present?) %>
              <p class="mt-1 text-xs <%= whatsapp_delivery_failed?(message) ? "font-semibold text-rose-200" : "text-slate-300" %>"><%= whatsapp_delivery_label(message) %></p>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @messages.blank? %>
        <p class="text-sm text-slate-500">Todavía no hay mensajes.</p>
      <% end %>
    </div>

    <div class="border-t border-slate-200 bg-white px-5 py-5">
      <h3 class="text-base font-semibold text-slate-950">Responder al huésped</h3>
      <p class="mt-1 text-sm text-slate-500">El mensaje se envía por WhatsApp desde Ayla. El huésped no ve tu número personal.</p>
      <%= form_with scope: :reply, url: reply_conversation_path(@conversation), class: "mt-4 space-y-3" do |form| %>
        <%= form.text_area :body,
          rows: 4,
          class: field_class,
          required: true,
          placeholder: "Escribí la respuesta para el huésped..." %>
        <div class="flex justify-end">
          <%= form.submit "Enviar por WhatsApp", class: primary_button_class %>
        </div>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <div class="border-t border-slate-200 bg-white px-5 py-5">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h3 class="text-base font-semibold text-slate-950">AI Trace</h3>
            <p class="mt-1 text-sm text-slate-500">Vista interna para auditar qué hizo la IA con cada mensaje de esta conversación.</p>
          </div>
          <%= link_to "Ver trazas filtradas", admin_ai_traces_path(conversation_id: @conversation.id), class: secondary_button_class %>
        </div>

        <div class="mt-4 space-y-3">
          <% @ai_decision_logs.each do |trace| %>
            <% trace_payload = trace.payload.to_h %>
            <%= link_to admin_ai_trace_path(trace, conversation_id: @conversation.id), class: "block rounded-lg border border-slate-200 p-4 transition hover:bg-slate-50" do %>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(trace.final_outcome || trace.decision) %>"><%= trace.final_outcome || trace.decision || "Sin decisión" %></span>
                    <% if trace.fallback? %>
                      <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">Fallback</span>
                    <% end %>
                    <% if trace.validation_failed? %>
                      <span class="rounded-full bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-700 ring-1 ring-rose-200">Validación fallida</span>
                    <% end %>
                  </div>
                  <p class="mt-2 text-sm font-medium text-slate-950"><%= trace.original_message&.body || trace.message&.body || "Mensaje no disponible" %></p>
                  <% if trace.checkin_trace.present? %>
                    <p class="mt-1 text-xs font-semibold text-indigo-700">CHECKIN_TRACE disponible</p>
                  <% end %>
                </div>
                <div class="text-sm text-slate-500 sm:text-right">
                  <p><%= local_datetime(trace.created_at) %></p>
                  <p>Tools: <%= trace.tool_calls.size %> · Evidence: <%= Array(trace.evidence_ids).size %></p>
                  <p>WhatsApp: <%= trace_payload.dig("whatsapp_delivery", "delivery_status") || trace.provider_delivery_status || "sin datos" %></p>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if @ai_decision_logs.blank? %>
            <p class="rounded-lg border border-dashed border-slate-200 p-4 text-sm text-slate-500">Todavía no hay trazas de IA para esta conversación.</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <aside class="space-y-4">
    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Huésped</h3>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-slate-500">Teléfono</dt>
          <dd class="font-medium text-slate-900"><%= display_phone_number(@conversation.guest.phone_number) %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Idioma</dt>
          <dd class="font-medium text-slate-900"><%= @conversation.guest.language.presence || "Sin configurar" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Reserva</dt>
          <dd class="font-medium text-slate-900"><%= @conversation.guest.reservation_reference.presence || "Sin configurar" %></dd>
        </div>
      </dl>
    </div>

    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Alertas de la conversación</h3>
      <div class="mt-4 space-y-3" data-conversation-refresh-target="alerts">
        <% @alerts.each do |alert| %>
          <%= link_to alert_path(alert), class: "block rounded-lg border border-slate-200 p-3 transition hover:bg-slate-50" do %>
            <p class="text-sm font-medium text-slate-950"><%= alert_display_title(alert) %></p>
            <p class="mt-1 text-xs text-slate-500"><%= enum_label(alert.priority) %> · <%= enum_label(alert.status) %></p>
          <% end %>
        <% end %>
        <% if @alerts.blank? %>
          <p class="text-sm text-slate-500">No hay alertas para esta conversación.</p>
        <% end %>
      </div>
    </div>
  </aside>
</div>
