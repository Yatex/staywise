<% content_for :page_title, "Conversación" %>

<div class="grid gap-6 xl:grid-cols-[1fr_340px]" data-controller="conversation-refresh" data-conversation-refresh-url-value="<%= refresh_conversation_path(@conversation) %>" data-conversation-refresh-interval-value="30000">
  <section class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <%= link_to "Volver a conversaciones", conversations_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
      <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-950"><%= conversation_display_title(@conversation) %></h2>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <span class="<%= property_tag_class %>"><%= @conversation.property.display_name %></span>
            <span class="text-sm text-slate-500">WhatsApp</span>
          </div>
        </div>
        <span data-conversation-refresh-target="status" class="w-fit rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@conversation.status) %>"><%= enum_label(@conversation.status) %></span>
      </div>
    </div>

    <%= render "messages", messages: @messages %>

    <div class="border-t border-slate-200 bg-white px-5 py-5">
      <h3 class="text-base font-semibold text-slate-950">Responder al huésped</h3>
      <p class="mt-1 text-sm text-slate-500">El mensaje se envía por WhatsApp desde Ayla. El huésped no ve tu número personal.</p>
      <%= form_with scope: :reply, url: reply_conversation_path(@conversation), class: "mt-4 space-y-3" do |form| %>
        <%= form.text_area :body,
          rows: 4,
          class: field_class,
          required: true,
          placeholder: "Escribí la respuesta para el huésped..." %>
        <div class="flex justify-end">
          <%= form.submit "Enviar por WhatsApp", class: primary_button_class %>
        </div>
      <% end %>
    </div>

  </section>

  <aside class="space-y-4">
    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Huésped</h3>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-slate-500">Teléfono</dt>
          <dd class="font-medium text-slate-900"><%= display_phone_number(@conversation.guest.phone_number) %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Idioma</dt>
          <dd class="font-medium text-slate-900"><%= @conversation.guest.language.presence || "Sin configurar" %></dd>
        </div>
        <div>
          <dt class="text-slate-500">Reserva</dt>
          <dd class="font-medium text-slate-900"><%= @conversation.guest.reservation_reference.presence || "Sin configurar" %></dd>
        </div>
      </dl>
    </div>

    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Alertas de la conversación</h3>
      <%= render "alerts", alerts: @alerts %>
    </div>
  </aside>
</div>
