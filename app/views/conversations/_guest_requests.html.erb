<div class="mt-4 space-y-3" data-conversation-refresh-target="guestRequests">
  <% guest_requests.each do |guest_request| %>
    <%= link_to guest_request_path(guest_request), class: "block rounded-lg border border-slate-200 p-3 transition hover:bg-slate-50" do %>
      <p class="text-sm font-medium text-slate-950"><%= guest_request.title %></p>
      <p class="mt-1 text-xs text-slate-500"><%= enum_label(guest_request.category) %> · <%= enum_label(guest_request.status) %></p>
      <p class="mt-2 text-xs text-slate-500"><%= enum_label(guest_request.status) %></p>
    <% end %>
  <% end %>
  <% if guest_requests.blank? %>
    <p class="text-sm text-slate-500">No hay pedidos para esta conversación.</p>
  <% end %>
</div>
