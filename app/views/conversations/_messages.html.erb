<div class="bg-slate-50 px-5 py-6"
     data-conversation-refresh-target="messages"
     data-last-message-id="<%= messages.last&.id || 0 %>">
  <%= render "older_messages_control",
    conversation: conversation,
    messages: messages,
    has_older_messages: has_older_messages,
    translation_mode: translation_mode %>
  <div id="conversation-messages-list" class="space-y-4">
    <%= render "message_rows",
      messages: messages,
      guest_request_message_ids: guest_request_message_ids,
      preferred_language: preferred_language,
      translation_mode: translation_mode %>
  </div>
  <% if messages.blank? %>
    <p class="text-sm text-slate-500">Todavía no hay mensajes.</p>
  <% end %>
</div>
