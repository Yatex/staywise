<% messages.each do |message| %>
  <div id="message-<%= message.id %>"
       data-message-id="<%= message.id %>"
       class="flex <%= message.sender == "guest" ? "justify-start" : "justify-end" %>">
    <div class="<%= message.sender == "guest" ? "border-slate-200 bg-white text-slate-800" : "border-slate-900 bg-slate-900 text-white" %> max-w-[760px] rounded-xl border px-4 py-3 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide <%= message.sender == "guest" ? "text-slate-400" : "text-slate-300" %>"><%= enum_label(message.sender) %></p>
      <p class="mt-2 whitespace-pre-line text-sm leading-6"><%= conversation_message_body(
        message,
        preferred_language: preferred_language,
        translation_mode: translation_mode
      ) %></p>
      <% if conversation_message_translation_pending?(message, preferred_language: preferred_language, translation_mode: translation_mode) %>
        <p class="mt-2 text-xs <%= message.sender == "guest" ? "text-sky-600" : "text-sky-200" %>"><%= t("ui.conversation_translation.pending") %></p>
      <% elsif translation_mode == "translated" && message.message_translations.any? { |translation| translation.target_language == preferred_language && translation.status == "failed" } %>
        <p class="mt-2 text-xs <%= message.sender == "guest" ? "text-amber-600" : "text-amber-200" %>"><%= t("ui.conversation_translation.failed") %></p>
      <% elsif translation_mode == "translated" && message.translation_for(preferred_language).present? %>
        <p class="mt-2 text-xs <%= message.sender == "guest" ? "text-slate-400" : "text-slate-300" %>"><%= t("ui.conversation_translation.translated_from", source: language_label(message.detected_language || message.translation_for(preferred_language).source_language).downcase) %></p>
      <% end %>
      <% if local_assigns.fetch(:guest_request_message_ids, []).include?(message.id) %>
        <p class="mt-3 inline-flex rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">Pedido creado</p>
      <% end %>
      <p class="mt-3 text-xs <%= message.sender == "guest" ? "text-slate-400" : "text-slate-300" %>"><%= local_datetime(message.created_at) %></p>
      <% if message.sender != "guest" && (message.metadata["delivery_status"].present? || message.metadata["provider_status"].present?) %>
        <p class="mt-1 text-xs <%= whatsapp_delivery_failed?(message) ? "font-semibold text-rose-200" : "text-slate-300" %>"><%= whatsapp_delivery_label(message) %></p>
      <% end %>
    </div>
  </div>
<% end %>
