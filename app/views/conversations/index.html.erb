<% content_for :page_title, t("ui.nav.conversations") %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-950"><%= t("ui.conversations.title") %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t("ui.conversations.subtitle") %></p>
    </div>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Archivo histórico · solo lectura</span>
  </div>

  <div class="<%= card_class %> overflow-hidden">
    <div class="divide-y divide-slate-100">
      <% @conversations.each do |conversation| %>
        <% display_property = @conversation_display_properties[@conversation_display_property_ids[conversation.id]] || conversation.property %>
        <%= link_to conversation_path(conversation), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium text-slate-950"><%= conversation_display_title(conversation) %></p>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="<%= property_tag_class %>"><%= display_property&.display_name || "Propiedad no disponible" %></span>
                <span class="text-sm text-slate-500"><%= t("ui.conversations.messages_count", count: @message_counts[conversation.id].to_i) %></span>
                <% if @last_ai_responses[conversation.id].present? %>
                  <span class="text-xs text-slate-500">Respuesta histórica de Ayla hace <%= time_ago_in_words(@last_ai_responses[conversation.id]) %></span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @conversations.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500"><%= t("ui.conversations.empty") %></p>
      <% end %>
    </div>
  </div>

  <% if @total_pages.to_i > 1 %>
    <div class="flex items-center justify-between">
      <p class="text-sm text-slate-500">Página <%= @current_page %> de <%= @total_pages %></p>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "Anterior", conversations_path(request.query_parameters.merge(page: @current_page - 1)), class: secondary_button_class %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Siguiente", conversations_path(request.query_parameters.merge(page: @current_page + 1)), class: secondary_button_class %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
