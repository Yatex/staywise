<% content_for :page_title, "Conversations" %>

<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-slate-950">Guest conversations</h2>
    <p class="mt-1 text-sm text-slate-500">WhatsApp threads with AI replies, owner escalations, and guest context.</p>
  </div>

  <div class="<%= card_class %> overflow-hidden">
    <div class="divide-y divide-slate-100">
      <% @conversations.each do |conversation| %>
        <%= link_to conversation_path(conversation), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium text-slate-950"><%= conversation.guest.display_name %></p>
              <p class="mt-1 text-sm text-slate-500"><%= conversation.property.display_name %> · <%= conversation.messages.count %> messages</p>
            </div>
            <div class="flex items-center gap-2">
              <% unless conversation.ai_enabled? %>
                <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">AI off</span>
              <% end %>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(conversation.status) %>"><%= conversation.status.humanize %></span>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if @conversations.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">No conversations yet.</p>
      <% end %>
    </div>
  </div>
</div>
