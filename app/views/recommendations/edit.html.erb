<% content_for :page_title, "Edit recommendation" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Back to property", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Edit recommendation</h2>
  </div>
  <%= render "form", property: @property, recommendation: @recommendation %>
  <div class="mt-4 text-right">
    <%= button_to "Delete recommendation", property_recommendation_path(@property, @recommendation), method: :delete, class: "text-sm font-semibold text-rose-600 hover:text-rose-700" %>
  </div>
</div>
