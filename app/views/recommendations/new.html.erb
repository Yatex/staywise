<% content_for :page_title, "New recommendation" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Back to property", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Add local recommendation</h2>
  </div>
  <%= render "shared/source_selector",
    sources: @source_recommendations,
    url: new_property_recommendation_path(@property),
    title: "Reuse a recommendation",
    description: "Start with a place from another property and adjust distance, notes, or links.",
    label: ->(recommendation) { "#{recommendation.property.display_name} - #{recommendation.name}" } %>
  <%= render "form", property: @property, recommendation: @recommendation %>
</div>
