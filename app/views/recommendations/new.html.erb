<% content_for :page_title, "Nueva recomendación" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Volver a la propiedad", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Agregar recomendación local</h2>
  </div>
  <%= render "shared/source_selector",
    sources: @source_recommendations,
    url: new_property_recommendation_path(@property),
    title: "Reusar una recomendación",
    description: "Empezá con un lugar de otra propiedad y ajustá distancia, notas o enlaces.",
    label: ->(recommendation) { "#{recommendation.property.display_name} - #{recommendation.name}" } %>
  <%= render "form", property: @property, recommendation: @recommendation %>
</div>
