<% content_for :page_title, "Configuración" %>

<% sections = [
  ["profile", "Mi perfil", "Datos personales y contraseña"],
  ["ai", "Ayla AI", "Respuesta automática"],
  ["whatsapp", "WhatsApp", "Notificaciones y modo observador"]
] %>

<div class="mx-auto max-w-5xl space-y-5">
  <% if @settings_error.present? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @settings_error %></div>
  <% end %>

  <nav class="grid gap-2 rounded-xl border border-slate-200 bg-white p-2 shadow-sm sm:grid-cols-3" aria-label="Secciones de configuración">
    <% sections.each do |key, title, description| %>
      <% active = settings_section == key %>
      <%= link_to settings_path(section: key),
        class: "rounded-lg px-4 py-3 transition #{active ? 'bg-slate-900 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-950'}",
        aria: { current: active ? "page" : nil } do %>
        <span class="block text-sm font-semibold"><%= title %></span>
        <span class="mt-0.5 block text-xs <%= active ? 'text-slate-300' : 'text-slate-400' %>"><%= description %></span>
      <% end %>
    <% end %>
  </nav>

  <%= render "#{settings_section}_section" %>
</div>
