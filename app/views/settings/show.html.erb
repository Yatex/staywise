<% content_for :page_title, "Configuración" %>

<div class="mx-auto max-w-5xl">
  <% if @settings_error.present? %>
    <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= @settings_error %></div>
  <% end %>

  <%= form_with scope: :user, url: settings_path, method: :patch, class: "space-y-6" do |form| %>
    <section class="<%= card_class %> p-5">
      <h2 class="text-base font-semibold text-slate-950">Perfil</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
          <%= form.label :name, "Tu nombre", class: label_class %>
          <%= form.text_field :name, value: @user.name, class: field_class %>
        </div>
      </div>
    </section>

    <section class="<%= card_class %> p-5">
      <h2 class="text-base font-semibold text-slate-950">Cambiar contraseña</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        <div>
          <%= form.label :current_password, "Contraseña actual", class: label_class %>
          <%= form.password_field :current_password, autocomplete: "current-password", class: field_class %>
        </div>
        <div>
          <%= form.label :password, "Nueva contraseña", class: label_class %>
          <%= form.password_field :password, autocomplete: "new-password", minlength: 8, class: field_class %>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirmar contraseña", class: label_class %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", minlength: 8, class: field_class %>
        </div>
      </div>
    </section>

    <div class="flex justify-end">
      <%= form.submit "Guardar cambios", class: primary_button_class %>
    </div>
  <% end %>

  <section class="<%= card_class %> mt-6 p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-base font-semibold text-slate-950">Ayla AI</h2>
        <p class="mt-1 text-sm text-slate-500"><%= @account.ai_active? ? "La IA está respondiendo automáticamente." : "La IA está apagada para esta cuenta." %></p>
      </div>
      <%= button_to @account.ai_active? ? "Apagar AI" : "Activar AI",
        settings_path,
        method: :patch,
        params: { account: { ai_active: @account.ai_active? ? "0" : "1" } },
        class: @account.ai_active? ? "inline-flex items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700" : primary_button_class %>
    </div>
  </section>

  <%= form_with model: @account, scope: :account, url: settings_path, method: :patch, class: "mt-6" do |form| %>
    <section class="<%= card_class %> p-5">
      <h2 class="text-base font-semibold text-slate-950">Escalaciones por WhatsApp</h2>
      <p class="mt-1 text-sm text-slate-500">Ayla puede avisarle al anfitrión por WhatsApp cuando no sabe responder, y usar su respuesta para contestarle al huésped.</p>
      <% unless @account.owner_whatsapp_configured? %>
        <div class="mt-4 flex gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="alert" data-testid="owner-whatsapp-warning">
          <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.485 2.495a1.75 1.75 0 0 1 3.03 0l6.28 10.88A1.75 1.75 0 0 1 16.28 16H3.72a1.75 1.75 0 0 1-1.515-2.625l6.28-10.88ZM10 6.25a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0V7a.75.75 0 0 1 .75-.75Zm0 7.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
          </svg>
          <div>
            <p class="font-semibold">WhatsApp del anfitrión sin configurar</p>
            <p class="mt-1">
              <% if @account.owner_whatsapp_number.blank? %>
                Ingresá el número del anfitrión y activá las notificaciones para recibir pedidos, consultas y alertas.
              <% else %>
                Activá las notificaciones para que Ayla pueda enviar pedidos, consultas y alertas a este número.
              <% end %>
            </p>
          </div>
        </div>
      <% end %>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
          <%= form.label :owner_whatsapp_number, "WhatsApp del anfitrión", class: label_class %>
          <%= form.telephone_field :owner_whatsapp_number, value: @account.owner_whatsapp_number, class: field_class, placeholder: "+598..." %>
        </div>
        <label class="flex items-center gap-3 rounded-lg border border-slate-200 p-4 text-sm font-medium text-slate-700">
          <%= form.check_box :owner_whatsapp_escalations_enabled, class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
          Recibir preguntas escaladas por WhatsApp
        </label>
      </div>
      <div class="mt-4 flex justify-end">
        <%= form.submit "Guardar WhatsApp", class: secondary_button_class %>
      </div>
    </section>
  <% end %>

  <% if @user.owner? || @user.admin? %>
    <%= form_with model: @account, scope: :account, url: settings_path, method: :patch, class: "mt-6" do |form| %>
      <section class="<%= card_class %> p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="text-base font-semibold text-slate-950">Modo observador</h2>
            <p class="mt-1 max-w-3xl text-sm text-slate-500">Recibí avisos cuando haya nueva actividad en las conversaciones de tus huéspedes. Las conversaciones completas se siguen revisando desde Ayla para evitar llenar tu WhatsApp de mensajes.</p>
          </div>
          <label class="flex shrink-0 items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700">
            <%= form.check_box :observer_mode_enabled, class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
            Activado
          </label>
        </div>
        <% if @account.owner_whatsapp_number.blank? %>
          <p class="mt-3 text-xs font-semibold text-amber-700">Configurá tu WhatsApp para poder recibir estos avisos.</p>
        <% end %>
        <div class="mt-4 flex justify-end">
          <%= form.submit "Guardar modo observador", class: secondary_button_class %>
        </div>
      </section>
    <% end %>

    <% if @account.co_hosts.any? %>
      <section class="<%= card_class %> mt-6 p-5">
        <h2 class="text-base font-semibold text-slate-950">Modo observador de co-hosts</h2>
        <div class="mt-4 divide-y divide-slate-100">
          <% @account.co_hosts.order(:name).each do |co_host| %>
            <div class="flex items-center justify-between gap-4 py-3">
              <div>
                <p class="text-sm font-medium text-slate-900"><%= co_host.name %></p>
                <% property_count = co_host.properties.count %>
                <p class="text-xs text-slate-500"><%= co_host.whatsapp_number %> · <%= property_count %> <%= property_count == 1 ? "propiedad" : "propiedades" %></p>
              </div>
              <%= button_to co_host.observer_mode_enabled? ? "Desactivar" : "Activar",
                co_host_observer_mode_path(co_host),
                method: :patch,
                params: { observer_mode_enabled: co_host.observer_mode_enabled? ? "0" : "1" },
                class: co_host.observer_mode_enabled? ? secondary_button_class : primary_button_class %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
