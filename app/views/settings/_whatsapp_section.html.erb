<%= form_with model: @account, scope: :account, url: settings_path, method: :patch do |form| %>
  <%= hidden_field_tag :section, "whatsapp" %>
  <section class="<%= card_class %> p-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-base font-semibold text-slate-950">WhatsApp del anfitrión</h2>
        <p class="mt-1 max-w-2xl text-sm text-slate-500">Ayla enviará a este número los pedidos, consultas y alertas que necesiten tu atención.</p>
      </div>
      <% if @account.owner_whatsapp_configured? %>
        <span class="w-fit rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200">Notificaciones activas</span>
      <% end %>
    </div>

    <% unless @account.owner_whatsapp_configured? %>
      <div class="mt-4 flex gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="alert" data-testid="owner-whatsapp-warning">
        <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495a1.75 1.75 0 0 1 3.03 0l6.28 10.88A1.75 1.75 0 0 1 16.28 16H3.72a1.75 1.75 0 0 1-1.515-2.625l6.28-10.88ZM10 6.25a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0V7a.75.75 0 0 1 .75-.75Zm0 7.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
        <div>
          <p class="font-semibold">WhatsApp sin configurar</p>
          <p class="mt-1"><%= @account.owner_whatsapp_number.present? ? "Guardá este número para activar automáticamente las notificaciones." : "Ingresá tu número para empezar a recibir notificaciones." %></p>
        </div>
      </div>
    <% end %>

    <div class="mt-5 max-w-xl">
      <%= form.label :owner_whatsapp_number, "Número de WhatsApp", class: label_class %>
      <%= form.telephone_field :owner_whatsapp_number, value: @account.owner_whatsapp_number, class: field_class, placeholder: "+598...", autocomplete: "tel" %>
      <p class="mt-2 text-xs text-slate-500">Al guardar un número, las notificaciones quedan activadas automáticamente. Para dejar de recibirlas, eliminá el número.</p>
    </div>
    <div class="mt-5 flex justify-end">
      <%= form.submit "Guardar WhatsApp", class: primary_button_class %>
    </div>
  </section>
<% end %>

<% if @user.owner? || @user.admin? %>
  <%= form_with model: @account, scope: :account, url: settings_path, method: :patch, class: "mt-5" do |form| %>
    <%= hidden_field_tag :section, "whatsapp" %>
    <section class="<%= card_class %> p-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-base font-semibold text-slate-950">Modo observador</h2>
          <p class="mt-1 max-w-3xl text-sm text-slate-500">Recibí avisos de nueva actividad y revisá la conversación completa desde Ayla, sin llenar tu WhatsApp de mensajes.</p>
        </div>
        <label class="flex shrink-0 items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700">
          <%= form.check_box :observer_mode_enabled, class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
          Activado
        </label>
      </div>
      <% if @account.owner_whatsapp_number.blank? %>
        <p class="mt-3 text-xs font-semibold text-amber-700">Primero configurá tu WhatsApp para recibir estos avisos.</p>
      <% end %>
      <div class="mt-4 flex justify-end">
        <%= form.submit "Guardar modo observador", class: secondary_button_class %>
      </div>
    </section>
  <% end %>

  <% if @account.co_hosts.any? %>
    <section class="<%= card_class %> mt-5 p-5">
      <h2 class="text-base font-semibold text-slate-950">Co-hosts</h2>
      <p class="mt-1 text-sm text-slate-500">Elegí qué co-hosts reciben avisos de actividad de sus propiedades.</p>
      <div class="mt-4 divide-y divide-slate-100">
        <% @account.co_hosts.order(:name).each do |co_host| %>
          <div class="flex items-center justify-between gap-4 py-3">
            <div>
              <p class="text-sm font-medium text-slate-900"><%= co_host.name %></p>
              <% property_count = co_host.properties.count %>
              <p class="text-xs text-slate-500"><%= co_host.whatsapp_number %> · <%= property_count %> <%= property_count == 1 ? "propiedad" : "propiedades" %></p>
            </div>
            <div class="flex items-center gap-2">
              <%= form_with url: co_host_conversation_language_path(co_host), method: :patch, class: "flex items-center gap-2" do |form| %>
                <%= form.select :preferred_conversation_language,
                  language_options,
                  { selected: co_host.preferred_conversation_language },
                  class: "rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm" %>
                <%= form.submit "Guardar idioma", class: secondary_button_class %>
              <% end %>
              <%= button_to co_host.observer_mode_enabled? ? "Desactivar" : "Activar",
                co_host_observer_mode_path(co_host),
                method: :patch,
                params: { observer_mode_enabled: co_host.observer_mode_enabled? ? "0" : "1" },
                class: co_host.observer_mode_enabled? ? secondary_button_class : primary_button_class %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
