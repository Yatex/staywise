<% inquiry_view = @task_kind == "inquiry" %>
<% section_title = inquiry_view ? "Consultas" : "Pedidos" %>
<% collection_path = inquiry_view ? inquiries_path : guest_requests_path %>
<% content_for :page_title, section_title %>

<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-slate-950"><%= section_title %></h2>
    <p class="mt-1 text-sm text-slate-500"><%= inquiry_view ? "Preguntas de huéspedes que necesitan información del propietario." : "Solicitudes de huéspedes detectadas por Ayla desde WhatsApp." %></p>
  </div>

  <%= form_with url: collection_path, method: :get, class: "#{card_class} grid gap-4 p-5 md:grid-cols-[1fr_1fr_auto]" do |form| %>
    <div>
      <%= form.label :property_id, "Propiedad", class: label_class %>
      <%= form.select :property_id,
        options_from_collection_for_select(@properties, :id, :display_name, params[:property_id]),
        { include_blank: "Todas" },
        class: field_class %>
    </div>
    <div>
      <%= form.label :status, "Estado", class: label_class %>
      <%= form.select :status,
        GuestRequest::STATUSES.map { |status| [enum_label(status), status] },
        { include_blank: "Todos" },
        class: field_class %>
    </div>
    <div class="flex items-end gap-2">
      <%= form.submit "Filtrar", class: primary_button_class %>
      <%= link_to "Limpiar", collection_path, class: secondary_button_class %>
    </div>
  <% end %>

  <div class="<%= card_class %> overflow-hidden">
    <div class="divide-y divide-slate-100">
      <% @guest_requests.each do |guest_request| %>
        <div class="px-5 py-4 transition hover:bg-slate-50">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <%= link_to(inquiry_view ? inquiry_path(guest_request) : guest_request_path(guest_request), class: "min-w-0 flex-1") do %>
              <span class="text-xs font-semibold text-slate-500"><%= inquiry_view ? "Consulta" : "Pedido" %></span>
              <p class="font-medium text-slate-950"><%= guest_request.title %></p>
              <p class="mt-1 text-sm text-slate-500">
                <%= guest_request.guest&.display_name.presence || display_phone_number(guest_request.guest_phone) %>
                · <%= guest_request.property_name %>
                · <%= l(guest_request.created_at, format: :short) %>
              </p>
            <% end %>
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
              <div class="flex flex-wrap items-center gap-2" aria-label="Estado">
                <% if guest_request.status == "open" && guest_request.requires_owner_approval? %>
                  <span class="rounded-full bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-700 ring-1 ring-rose-200">Requiere aprobación</span>
                <% end %>
                <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(guest_request.status) %>"><%= enum_label(guest_request.status) %></span>
              </div>

              <% next_status = guest_request.status == "open" ? "resolved" : "open" %>
              <% action_label = next_status == "resolved" ? "Marcar como resuelto" : "Reabrir" %>
              <div class="border-t border-slate-200 pt-3 sm:border-l sm:border-t-0 sm:pl-3 sm:pt-0" aria-label="Acciones">
                <%= link_to "Abrir conversación", conversation_path(guest_request.conversation), class: "mr-2 inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-slate-950" %>
                <%= button_to action_label,
                  inquiry_view ? inquiry_path(guest_request) : guest_request_path(guest_request),
                  method: :patch,
                  params: { guest_request: { status: next_status } },
                  class: "inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-slate-950" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <% if @guest_requests.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">No hay <%= inquiry_view ? "consultas" : "pedidos" %> para mostrar.</p>
      <% end %>
    </div>
  </div>

  <% if @total_pages.to_i > 1 %>
    <div class="flex items-center justify-between">
      <p class="text-sm text-slate-500">Página <%= @current_page %> de <%= @total_pages %></p>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "Anterior", url_for(request.query_parameters.merge(page: @current_page - 1)), class: secondary_button_class %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Siguiente", url_for(request.query_parameters.merge(page: @current_page + 1)), class: secondary_button_class %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
