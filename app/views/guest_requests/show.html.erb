<% content_for :page_title, @guest_request.title %>

<div class="mx-auto max-w-4xl space-y-6">
  <section class="<%= card_class %> p-5">
    <%= link_to "Volver a pedidos", guest_requests_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-slate-950"><%= @guest_request.title %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= enum_label(@guest_request.category) %> · <%= @guest_request.property_name %></p>
      </div>
      <div class="flex gap-2">
        <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@guest_request.priority) %>"><%= enum_label(@guest_request.priority) %></span>
        <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@guest_request.status) %>"><%= enum_label(@guest_request.status) %></span>
      </div>
    </div>

    <dl class="mt-6 grid gap-4 rounded-lg bg-slate-50 p-4 text-sm md:grid-cols-2">
      <div>
        <dt class="text-slate-500">Huésped</dt>
        <dd class="font-medium text-slate-900"><%= display_phone_number(@guest_request.guest_phone) %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Dirección</dt>
        <dd class="font-medium text-slate-900"><%= @guest_request.property_address.presence || "Sin dirección configurada" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Origen</dt>
        <dd class="font-medium text-slate-900"><%= enum_label(@guest_request.source_channel) %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Creado</dt>
        <dd class="font-medium text-slate-900"><%= local_long_datetime(@guest_request.created_at) %></dd>
      </div>
    </dl>

    <div class="mt-4 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Mensaje original</p>
      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= @guest_request.description %></p>
    </div>

    <div class="mt-4 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Resumen de Ayla</p>
      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= @guest_request.ai_summary.presence || "Sin resumen." %></p>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Actualizar pedido</h3>
    <%= form_with model: @guest_request, class: "mt-4 grid gap-4 md:grid-cols-[1fr_1fr_auto]" do |form| %>
      <div>
        <%= form.label :status, "Estado", class: label_class %>
        <%= form.select :status, GuestRequest::STATUSES.map { |status| [enum_label(status), status] }, {}, class: field_class %>
      </div>
      <div>
        <%= form.label :priority, "Prioridad", class: label_class %>
        <%= form.select :priority, GuestRequest::PRIORITIES.map { |priority| [enum_label(priority), priority] }, {}, class: field_class %>
      </div>
      <div class="flex items-end">
        <%= form.submit "Guardar", class: primary_button_class %>
      </div>
    <% end %>
  </section>

  <div class="flex flex-wrap gap-2">
    <% if @guest_request.conversation.present? %>
      <%= link_to "Abrir conversación", conversation_path(@guest_request.conversation), class: secondary_button_class %>
    <% end %>
    <% if @guest_request.ai_decision_log.present? && current_user.admin? %>
      <%= link_to "Ver AI Trace", admin_ai_trace_path(@guest_request.ai_decision_log), class: secondary_button_class %>
    <% end %>
  </div>
</div>
