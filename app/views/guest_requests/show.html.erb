<% inquiry_view = @task_kind == "inquiry" %>
<% item_path = inquiry_view ? inquiry_path(@guest_request) : guest_request_path(@guest_request) %>
<% content_for :page_title, @guest_request.title %>

<div class="mx-auto max-w-4xl space-y-6">
  <section class="<%= card_class %> p-5">
    <%= link_to(inquiry_view ? "Volver a consultas" : "Volver a pedidos", inquiry_view ? inquiries_path : guest_requests_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950") %>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <span class="text-xs font-semibold text-slate-500"><%= inquiry_view ? "Consulta" : "Pedido" %></span>
        <h2 class="mt-1 text-2xl font-semibold text-slate-950"><%= @guest_request.title %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= enum_label(@guest_request.category) %> · <%= @guest_request.property_name %></p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@guest_request.status) %>"><%= enum_label(@guest_request.status) %></span>
        <% if @guest_request.conversation.present? %>
          <%= link_to "Responder al huésped", conversation_path(@guest_request.conversation), class: primary_button_class %>
        <% end %>
      </div>
    </div>

    <dl class="mt-6 grid gap-4 rounded-lg bg-slate-50 p-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-slate-500">Quién lo pidió</dt>
        <dd class="mt-1 font-medium text-slate-900"><%= @guest_request.guest&.name.presence || display_phone_number(@guest_request.guest_phone) %></dd>
        <% if @guest_request.guest&.name.present? %>
          <dd class="mt-1 text-slate-500"><%= display_phone_number(@guest_request.guest_phone) %></dd>
        <% end %>
      </div>
      <div>
        <dt class="text-slate-500">Propiedad</dt>
        <dd class="mt-1 font-medium text-slate-900"><%= @guest_request.property_name %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Tipo</dt>
        <dd class="mt-1 font-medium text-slate-900"><%= inquiry_view ? "Consulta" : "Pedido" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Fecha</dt>
        <dd class="mt-1 font-medium text-slate-900"><%= l(@guest_request.created_at, format: :short) %></dd>
      </div>
    </dl>

    <div class="mt-4 rounded-lg bg-slate-50 p-4">
      <p class="text-sm text-slate-600">El contexto completo y las aclaraciones del huésped están en la conversación.</p>
      <%= link_to "Abrir conversación", conversation_path(@guest_request.conversation), class: "mt-3 inline-flex text-sm font-semibold text-slate-900 underline underline-offset-4" %>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Actualizar pedido</h3>
    <%= form_with model: @guest_request, url: item_path, class: "mt-4 flex flex-col gap-4 sm:flex-row sm:items-end" do |form| %>
      <div>
        <%= form.label :status, "Estado", class: label_class %>
        <%= form.select :status, GuestRequest::STATUSES.map { |status| [enum_label(status), status] }, {}, class: field_class %>
      </div>
      <div class="flex items-end">
        <%= form.submit "Guardar", class: primary_button_class %>
      </div>
    <% end %>
  </section>
</div>
