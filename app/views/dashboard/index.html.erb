<% content_for :page_title, "Panel" %>

<div class="space-y-6">
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    <% [
      ["Propiedades totales", @total_properties],
      ["Conversaciones activas", @active_conversations],
      ["Alertas abiertas", @open_alerts],
      ["Preguntas escaladas", @unanswered_questions],
      ["Respuestas recientes de IA", @recent_ai_responses.count]
    ].each do |label, value| %>
      <div class="<%= card_class %> p-4">
        <p class="text-sm text-slate-500"><%= label %></p>
        <p class="mt-3 text-3xl font-semibold text-slate-950"><%= value %></p>
      </div>
    <% end %>
  </section>

  <section class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="<%= card_class %> overflow-hidden">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-base font-semibold text-slate-950">Conversaciones recientes</h2>
          <p class="text-sm text-slate-500">Conversaciones de WhatsApp que la IA respondió o escaló.</p>
        </div>
        <%= link_to "Ver todo", conversations_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-950" %>
      </div>
      <div class="divide-y divide-slate-100">
        <% @recent_conversations.each do |conversation| %>
          <%= link_to conversation_path(conversation), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-slate-950"><%= conversation.guest.display_name %></p>
                <p class="mt-1 text-sm text-slate-500"><%= conversation.property.display_name %></p>
              </div>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(conversation.status) %>"><%= enum_label(conversation.status) %></span>
            </div>
          <% end %>
        <% end %>
        <% if @recent_conversations.blank? %>
          <p class="px-5 py-8 text-sm text-slate-500">Todavía no hay conversaciones. Los mensajes entrantes de WhatsApp aparecerán acá.</p>
        <% end %>
      </div>
    </div>

    <div class="<%= card_class %> overflow-hidden">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-base font-semibold text-slate-950">Alertas abiertas</h2>
          <p class="text-sm text-slate-500">Acción requerida del propietario.</p>
        </div>
        <%= link_to "Ver todo", alerts_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-950" %>
      </div>
      <div class="divide-y divide-slate-100">
        <% @alerts.each do |alert| %>
          <%= link_to alert_path(alert), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-slate-950"><%= alert.title %></p>
                <p class="mt-1 text-sm text-slate-500"><%= alert.property.display_name %></p>
              </div>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(alert.priority) %>"><%= enum_label(alert.priority) %></span>
            </div>
          <% end %>
        <% end %>
        <% if @alerts.blank? %>
          <p class="px-5 py-8 text-sm text-slate-500">No hay alertas abiertas.</p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-[1fr_1fr]">
    <div class="<%= card_class %> p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-950">Resumen de propiedades</h2>
        <%= link_to "Gestionar", properties_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-950" %>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <% @properties.each do |property| %>
          <%= link_to property_path(property), class: "rounded-lg border border-slate-200 p-4 transition hover:border-slate-300 hover:bg-slate-50" do %>
            <p class="font-medium text-slate-950"><%= property.display_name %></p>
            <p class="mt-1 text-sm text-slate-500"><%= property.address.presence || "Dirección sin configurar" %></p>
            <p class="mt-3 text-xs text-slate-400"><%= property.knowledge_blocks.size %> bloques de guía, <%= property.faqs.size %> FAQs</p>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="<%= card_class %> p-5">
      <h2 class="text-base font-semibold text-slate-950">Resumen de actividad de IA</h2>
      <div class="mt-4 space-y-3">
        <% @recent_ai_responses.each do |message| %>
          <div class="rounded-lg border border-slate-200 p-4">
            <p class="line-clamp-2 text-sm text-slate-700"><%= message.body %></p>
            <p class="mt-2 text-xs text-slate-400"><%= message.created_at.to_fs(:short) %></p>
          </div>
        <% end %>
        <% if @recent_ai_responses.blank? %>
          <p class="text-sm text-slate-500">Las respuestas de IA aparecerán cuando los huéspedes empiecen a escribir.</p>
        <% end %>
      </div>
      <div class="mt-5 rounded-lg bg-slate-50 p-4">
        <p class="text-sm font-semibold text-slate-900">Estado de suscripción</p>
        <p class="mt-1 text-sm text-slate-500">Plan <%= (@subscription ? enum_label(@subscription.plan).downcase : nil) || "inicial" %>, <%= (@subscription ? enum_label(@subscription.status).downcase : nil) || "incompleta" %></p>
      </div>
    </div>
  </section>
</div>
