<% content_for :page_title, t("ui.nav.dashboard") %>

<div class="space-y-6">
  <section class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="<%= card_class %> overflow-hidden">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-base font-semibold text-slate-950"><%= t("ui.dashboard.recent_chats") %></h2>
          <p class="text-sm text-slate-500"><%= t("ui.dashboard.recent_chats_body") %></p>
        </div>
        <%= link_to t("ui.actions.view_all"), conversations_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-950" %>
      </div>
      <div class="divide-y divide-slate-100">
        <% @recent_conversations.each do |conversation| %>
          <%= link_to conversation_path(conversation), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-slate-950"><%= conversation_display_title(conversation) %></p>
                <p class="mt-2"><span class="<%= property_tag_class %>"><%= conversation.property.display_name %></span></p>
              </div>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(conversation.status) %>"><%= enum_label(conversation.status) %></span>
            </div>
          <% end %>
        <% end %>
        <% if @recent_conversations.blank? %>
          <p class="px-5 py-8 text-sm text-slate-500"><%= t("ui.dashboard.no_conversations") %></p>
        <% end %>
      </div>
    </div>

    <div class="<%= card_class %> overflow-hidden">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-base font-semibold text-slate-950"><%= t("ui.dashboard.open_alerts") %></h2>
          <p class="text-sm text-slate-500"><%= t("ui.dashboard.open_alerts_body") %></p>
        </div>
        <%= link_to t("ui.actions.view_all"), alerts_path, class: "text-sm font-semibold text-slate-700 hover:text-slate-950" %>
      </div>
      <div class="divide-y divide-slate-100">
        <% @alerts.each do |alert| %>
          <%= link_to alert_path(alert), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-slate-950"><%= alert_display_title(alert) %></p>
                <p class="mt-1 text-sm text-slate-500"><%= alert.property.display_name %></p>
              </div>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(alert.priority) %>"><%= enum_label(alert.priority) %></span>
            </div>
          <% end %>
        <% end %>
        <% if @alerts.blank? %>
          <p class="px-5 py-8 text-sm text-slate-500"><%= t("ui.dashboard.no_alerts") %></p>
        <% end %>
      </div>
    </div>
  </section>
</div>
