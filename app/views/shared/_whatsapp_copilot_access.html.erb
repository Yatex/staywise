<% link = Whatsapp::HostCopilotDeepLink.call %>
<% if link.present? %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <%= image_tag whatsapp_copilot_qr_settings_path,
      alt: "QR para hablar con Ayla por WhatsApp",
      class: "h-28 w-28 shrink-0 rounded-xl border border-slate-200 bg-white p-2" %>
    <div class="min-w-0">
      <p class="font-semibold text-slate-950">Hablá con Ayla desde WhatsApp</p>
      <p class="mt-1 text-sm leading-6 text-slate-500">Escaneá el QR o abrí el chat desde el teléfono autorizado.</p>
      <p class="mt-1 text-sm font-medium text-slate-700"><%= Whatsapp::HostCopilotDeepLink.display_number %></p>
      <%= link_to "Abrir WhatsApp", link,
        target: "_blank",
        rel: "noopener noreferrer",
        class: "mt-3 inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700" %>
    </div>
  </div>
<% else %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    El número oficial de Ayla todavía no está configurado.
  </div>
<% end %>
