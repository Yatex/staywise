<aside class="border-b border-slate-200 bg-slate-50 px-4 py-4 transition-[width,padding] duration-200 lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r lg:px-5" data-sidebar-target="aside">
  <div class="flex items-center justify-between gap-2" data-sidebar-target="header">
    <div class="flex items-center gap-3">
      <%= image_tag "ayla-mark.svg", alt: "Ayla", class: "h-10 w-10 shrink-0 rounded-xl" %>
      <div data-sidebar-target="label">
        <p class="whitespace-nowrap text-base font-semibold text-slate-950">Ayla</p>
        <p class="whitespace-nowrap text-xs text-slate-500"><%= t("ui.layout.tagline") %></p>
      </div>
    </div>
    <button
      type="button"
      class="hidden h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-white hover:text-slate-950 lg:flex"
      aria-label="Contraer menú"
      aria-expanded="true"
      title="Contraer menú"
      data-sidebar-target="toggle"
      data-action="sidebar#toggle"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-sidebar-target="collapseIcon">
        <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-sidebar-target="expandIcon">
        <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <nav class="mt-6 grid grid-cols-2 gap-1 sm:grid-cols-4 lg:grid-cols-1">
    <% [
      ["Nueva consulta", new_copilot_thread_path, :new_consultation],
      ["Historial", copilot_threads_path, :history],
      [t("ui.nav.properties"), properties_path, :properties],
      [t("ui.nav.settings"), settings_path, :settings]
    ].each do |label, path, icon| %>
      <%= link_to path, class: nav_link_class(path), title: label, aria: { label: label }, data: { sidebar_target: "link" } do %>
        <%= sidebar_icon(icon) %>
        <span class="whitespace-nowrap" data-sidebar-target="label"><%= label %></span>
      <% end %>
    <% end %>
  </nav>

  <% recent_copilot_threads = current_user.copilot_threads.includes(:property).recent.limit(6) %>
  <% if recent_copilot_threads.any? %>
    <div class="mt-6 hidden border-t border-slate-200 pt-5 lg:block" data-sidebar-target="label">
      <div class="flex items-center justify-between px-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Recientes</p>
        <%= link_to "Ver todas", copilot_threads_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-900" %>
      </div>
      <nav class="mt-2 space-y-1">
        <% recent_copilot_threads.each do |thread| %>
          <%= link_to copilot_thread_path(thread), class: "block rounded-lg px-3 py-2 hover:bg-white" do %>
            <span class="block truncate text-sm font-medium text-slate-700"><%= thread.display_title %></span>
            <span class="mt-0.5 block truncate text-xs text-slate-400"><%= thread.property.display_name %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  <% end %>

  <details class="mt-5 hidden border-t border-slate-200 pt-4 lg:block" data-sidebar-target="label">
    <summary class="cursor-pointer px-3 text-xs font-semibold text-slate-400 hover:text-slate-700">Operación anterior</summary>
    <nav class="mt-2 space-y-1">
      <% [
        [t("ui.nav.dashboard"), dashboard_path],
        [t("ui.nav.conversations"), conversations_path],
        [t("ui.nav.guest_requests"), guest_requests_path],
        [t("ui.nav.inquiries"), inquiries_path],
        [t("ui.nav.alerts"), alerts_path],
        [t("ui.nav.checkout_events"), checkout_events_path]
      ].each do |label, path| %>
        <%= link_to label, path, class: "block rounded-lg px-3 py-2 text-sm text-slate-500 hover:bg-white hover:text-slate-900" %>
      <% end %>
    </nav>
  </details>

  <% if current_user.admin? %>
    <div class="mt-6 border-t border-slate-200 pt-5">
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-400" data-sidebar-target="label"><%= t("ui.nav.admin") %></p>
      <nav class="mt-2 grid gap-1">
        <% [["AI Trace", admin_ai_traces_path, :ai_trace]].each do |label, path, icon| %>
          <%= link_to path, class: nav_link_class(path), title: label, aria: { label: label }, data: { sidebar_target: "link" } do %>
            <%= sidebar_icon(icon) %>
            <span class="whitespace-nowrap" data-sidebar-target="label"><%= label %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  <% end %>

</aside>
