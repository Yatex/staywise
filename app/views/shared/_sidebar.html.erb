<aside class="border-b border-slate-200 bg-slate-50 px-4 py-4 lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r lg:px-5">
  <div class="flex items-center gap-3">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 text-sm font-bold text-white">S</div>
    <div>
      <p class="text-base font-semibold text-slate-950">Staywise</p>
      <p class="text-xs text-slate-500">Guest AI for stays</p>
    </div>
  </div>

  <nav class="mt-6 grid grid-cols-2 gap-1 sm:grid-cols-4 lg:grid-cols-1">
    <%= link_to "Dashboard", dashboard_path, class: nav_link_class(dashboard_path) %>
    <%= link_to "Properties", properties_path, class: nav_link_class(properties_path) %>
    <%= link_to "Conversations", conversations_path, class: nav_link_class(conversations_path) %>
    <%= link_to "Alerts", alerts_path, class: nav_link_class(alerts_path) %>
    <%= link_to "Recommendations", recommendations_path, class: nav_link_class(recommendations_path) %>
    <%= link_to "Guests", guests_path, class: nav_link_class(guests_path) %>
  </nav>

  <% if current_user.admin? %>
    <div class="mt-6 border-t border-slate-200 pt-5">
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Admin</p>
      <nav class="mt-2 grid gap-1">
        <%= link_to "Users", admin_users_path, class: nav_link_class(admin_users_path) %>
        <%= link_to "Stats", admin_stats_path, class: nav_link_class(admin_stats_path) %>
      </nav>
    </div>
  <% end %>

  <div class="mt-6 hidden rounded-xl border border-slate-200 bg-white p-4 lg:block">
    <p class="text-sm font-semibold text-slate-900">WhatsApp status</p>
    <p class="mt-1 text-sm text-slate-500"><%= current_account.whatsapp_enabled? ? "Provider enabled" : "Provider not connected" %></p>
  </div>
</aside>
