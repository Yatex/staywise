<div class="fixed left-1/2 top-4 z-50 w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 space-y-2" data-turbo-temporary>
  <% flash.each do |type, message| %>
    <% next if message.blank? %>
    <div
      class="<%= type.to_s == "alert" ? "border-rose-200 bg-rose-50 text-rose-700" : "border-emerald-200 bg-emerald-50 text-emerald-700" %> flex items-start justify-between gap-4 rounded-xl border px-4 py-3 text-sm font-medium shadow-sm transition duration-200"
      data-controller="dismissable"
      data-dismissable-timeout-value="3500"
    >
      <span><%= message %></span>
      <button type="button" class="shrink-0 text-current opacity-60 transition hover:opacity-100" aria-label="<%= t("ui.layout.close_notification") %>" data-action="dismissable#dismiss">x</button>
    </div>
  <% end %>
</div>
