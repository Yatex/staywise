<%= form_with model: property, multipart: true, class: "space-y-6", data: { controller: "property-import", action: "turbo:submit-start->property-import#submitStart turbo:submit-end->property-import#submitEnd" } do |form| %>
  <% if property.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <%= property.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">AI</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Importar información con Ayla</h2>
        <p class="mt-1 text-sm text-slate-500">Subí una imagen, PDF o archivo de texto con datos de la propiedad. Ayla completa los campos que pueda detectar para que los revises antes de guardar.</p>
        <% if defined?(@property_import_notice) && @property_import_notice.present? %>
          <div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
            <%= @property_import_notice %>
          </div>
        <% end %>
        <% if defined?(@property_import_error) && @property_import_error.present? %>
          <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">
            <%= @property_import_error %>
          </div>
        <% end %>
        <div class="mt-4 hidden rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-medium text-indigo-700" data-property-import-target="status"></div>
        <div class="mt-4 grid gap-3 md:grid-cols-[1fr_auto]">
          <%= file_field_tag "property_import[file]", accept: "image/*,.pdf,.txt,.md,.markdown,.csv,.json,.html,.htm,.xml", class: field_class %>
          <%= button_tag "Leer archivo con IA", type: "submit", name: "preview_import", value: "1", formnovalidate: true, class: secondary_button_class, data: { property_import_target: "button" } %>
        </div>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">1</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Datos básicos</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :name, "Nombre de la propiedad", class: label_class %>
            <%= form.text_field :name, class: field_class, required: true %>
          </div>
          <div>
            <%= form.label :internal_nickname, "Alias interno", class: label_class %>
            <%= form.text_field :internal_nickname, class: field_class %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :address, "Dirección", class: label_class %>
            <%= form.text_field :address, class: field_class %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :tag_list, "Etiquetas", class: label_class %>
            <%= form.text_field :tag_list, value: property.tag_list, class: field_class, placeholder: "playa, familiar, premium" %>
            <p class="mt-2 text-xs text-slate-500">Separá etiquetas con comas para agrupar y filtrar propiedades.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">2</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Llegada y check-in</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :check_in_time, "Horario de check-in", class: label_class %>
            <%= form.text_field :check_in_time, class: field_class, placeholder: "15:00" %>
          </div>
          <div>
            <%= form.label :access_instructions, "Instrucciones de acceso", class: label_class %>
            <%= form.text_area :access_instructions, rows: 5, class: field_class, placeholder: "Portón, código, caja de llaves, piso, referencias de entrada." %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :parking_instructions, "Estacionamiento", class: label_class %>
            <%= form.text_area :parking_instructions, rows: 4, class: field_class, placeholder: "Cochera incluida, parking cercano, reglas del edificio o dónde no estacionar." %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">3</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Durante la estadía</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :wifi_name, "Nombre de WiFi", class: label_class %>
            <%= form.text_field :wifi_name, class: field_class %>
          </div>
          <div>
            <%= form.label :wifi_password, "Contraseña de WiFi", class: label_class %>
            <%= form.text_field :wifi_password, class: field_class %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :ai_general_notes, "Notas útiles para responder durante la estadía", class: label_class %>
            <%= form.text_area :ai_general_notes, rows: 5, class: field_class, placeholder: "Electrodomésticos, calefacción, TV, lavarropas, amenities, recomendaciones internas." %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">4</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Reglas, seguridad y escalamiento</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :house_rules, "Reglas de la casa", class: label_class %>
            <%= form.text_area :house_rules, rows: 5, class: field_class, placeholder: "Ruido, visitas, fiestas, mascotas, fumar, horarios del edificio." %>
          </div>
          <div>
            <%= form.label :emergency_information, "Información de emergencia", class: label_class %>
            <%= form.text_area :emergency_information, rows: 5, class: field_class, placeholder: "Hospital, farmacia, botiquín, extintor, contactos importantes." %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :owner_contact_instructions, "Cuándo consultar al propietario", class: label_class %>
            <%= form.text_area :owner_contact_instructions, rows: 4, class: field_class, placeholder: "Late checkout, reembolsos, daños, emergencias, mantenimiento o permisos especiales." %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">5</span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">Checkout</h2>
        <div class="mt-4">
          <%= form.label :checkout_time, "Horario de checkout", class: label_class %>
          <%= form.text_field :checkout_time, class: field_class, placeholder: "11:00" %>
        </div>
      </div>
    </div>
  </section>

  <% show_initial_faqs = !property.persisted? || Array(@initial_faqs).any? { |faq| faq.to_h.values.any?(&:present?) } %>
  <% if show_initial_faqs %>
    <section class="<%= card_class %> p-5" data-controller="initial-faqs" data-initial-faqs-next-index-value="<%= Array(@initial_faqs).length %>">
      <div class="flex items-start gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white">6</span>
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-semibold text-slate-950"><%= property.persisted? ? "Preguntas frecuentes para agregar" : "Preguntas frecuentes iniciales" %></h2>
          <% if property.persisted? %>
            <p class="mt-1 text-sm text-slate-500">Estas FAQs se van a agregar a la propiedad cuando guardes los cambios.</p>
          <% end %>
          <div class="mt-4 space-y-4" data-initial-faqs-target="list">
            <% Array(@initial_faqs).each_with_index do |faq, index| %>
              <div class="rounded-lg border border-slate-200 p-4">
                <div class="grid gap-4 md:grid-cols-2">
                  <div>
                    <%= label_tag "property_initial_faqs_#{index}_question", "Pregunta", class: label_class %>
                    <%= text_field_tag "property[initial_faqs][][question]", faq["question"], id: "property_initial_faqs_#{index}_question", class: field_class, placeholder: "¿A qué hora es el checkout?" %>
                  </div>
                  <div>
                    <%= label_tag "property_initial_faqs_#{index}_category", "Categoría", class: label_class %>
                    <%= text_field_tag "property[initial_faqs][][category]", faq["category"], id: "property_initial_faqs_#{index}_category", class: field_class, placeholder: "checkout, acceso, amenities" %>
                  </div>
                  <div class="md:col-span-2">
                    <%= label_tag "property_initial_faqs_#{index}_answer", "Respuesta", class: label_class %>
                    <%= text_area_tag "property[initial_faqs][][answer]", faq["answer"], id: "property_initial_faqs_#{index}_answer", rows: 3, class: field_class, placeholder: "El checkout es a las 11:00. Dejás las llaves sobre la mesa." %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <template data-initial-faqs-target="template">
            <div class="rounded-lg border border-slate-200 p-4">
              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <%= label_tag "property_initial_faqs___INDEX___question", "Pregunta", class: label_class %>
                  <%= text_field_tag "property[initial_faqs][][question]", nil, id: "property_initial_faqs___INDEX___question", class: field_class, placeholder: "¿A qué hora es el checkout?" %>
                </div>
                <div>
                  <%= label_tag "property_initial_faqs___INDEX___category", "Categoría", class: label_class %>
                  <%= text_field_tag "property[initial_faqs][][category]", nil, id: "property_initial_faqs___INDEX___category", class: field_class, placeholder: "checkout, acceso, amenities" %>
                </div>
                <div class="md:col-span-2">
                  <%= label_tag "property_initial_faqs___INDEX___answer", "Respuesta", class: label_class %>
                  <%= text_area_tag "property[initial_faqs][][answer]", nil, id: "property_initial_faqs___INDEX___answer", rows: 3, class: field_class, placeholder: "El checkout es a las 11:00. Dejás las llaves sobre la mesa." %>
                </div>
              </div>
            </div>
          </template>
          <button type="button" class="<%= secondary_button_class %> mt-4" data-action="initial-faqs#add">Agregar FAQ</button>
        </div>
      </div>
    </section>
  <% end %>

  <section class="<%= card_class %> p-5">
    <div class="flex items-start gap-4">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-sm font-bold text-white"><%= show_initial_faqs ? "7" : "6" %></span>
      <div class="min-w-0 flex-1">
        <h2 class="text-base font-semibold text-slate-950">IA de esta propiedad</h2>
        <label class="mt-4 flex items-center gap-3 rounded-lg border border-slate-200 p-4 text-sm font-medium text-slate-700">
          <%= form.check_box :ai_enabled, class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
          Activar respuestas de IA para esta propiedad
        </label>
      </div>
    </div>
  </section>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", property.persisted? ? property_path(property) : properties_path, class: secondary_button_class %>
    <%= form.submit property.persisted? ? "Guardar cambios" : "Crear propiedad", class: primary_button_class %>
  </div>
<% end %>
