<% content_for :page_title, @property.display_name %>

<div class="space-y-6">
  <section class="<%= card_class %> p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <h2 class="text-2xl font-semibold text-slate-950"><%= @property.display_name %></h2>
          <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@property.status) %>"><%= enum_label(@property.status) %></span>
        </div>
        <% if @property.tags.any? %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% @property.tags.each do |tag| %>
              <%= link_to tag, properties_path(tag: tag), class: "rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200 hover:bg-slate-200" %>
            <% end %>
          </div>
        <% end %>
        <p class="mt-2 text-sm text-slate-500"><%= @property.address.presence || "Dirección sin configurar" %></p>
        <% if @property_read_only %>
          <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Vista administrativa · <%= @property.account.name %></p>
        <% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if @whatsapp_link.present? %>
          <button type="button" class="<%= secondary_button_class %>" data-controller="clipboard" data-clipboard-text-value="<%= @whatsapp_link %>" data-action="clipboard#copyText">Copiar link de WhatsApp</button>
        <% end %>
        <% unless @property_read_only %>
          <%= link_to "Editar propiedad", edit_property_path(@property), class: secondary_button_class %>
          <%= button_to "Eliminar propiedad",
            property_path(@property),
            method: :delete,
            class: "rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:bg-rose-50",
            form: { data: { turbo_confirm: "¿Seguro que querés eliminar esta propiedad?" } } %>
          <%= link_to "Agregar electrodoméstico", new_property_knowledge_block_path(@property, category: "appliances"), class: primary_button_class %>
        <% end %>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
      <% sections = [["Resumen", "#overview"], ["Información completa", "#property-information"], ["Guías y electrodomésticos", "#knowledge"], ["Recomendaciones locales", "#recommendations"], ["FAQs", "#faqs"], ["Consultas pendientes", "#new-questions"], ["QR de WhatsApp", "#whatsapp-qr"]] %>
      <% sections << ["Configuración", "#settings"] unless @property_read_only %>
      <% sections.each do |label, href| %>
        <a href="<%= href %>" class="whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950"><%= label %></a>
      <% end %>
    </div>
  </section>

  <section id="whatsapp-qr" class="grid gap-6 <%= "xl:grid-cols-[320px_1fr]" unless @property_read_only %>">
    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">QR de WhatsApp de la propiedad</h3>
      <p class="mt-1 text-sm text-slate-500">Los huéspedes lo escanean para hacer preguntas sobre esta propiedad.</p>
      <% if @whatsapp_link.present? %>
        <div class="mt-4 w-64 max-w-full rounded-xl border border-slate-200 bg-white p-4">
          <%= image_tag whatsapp_qr_property_path(@property, format: :svg), alt: "#{@property.display_name} QR de WhatsApp", class: "aspect-square w-full rounded-lg bg-slate-50" %>
        </div>
        <div class="mt-4 flex flex-wrap gap-2" data-controller="clipboard" data-clipboard-text-value="<%= @whatsapp_link %>" data-clipboard-url-value="<%= whatsapp_qr_property_path(@property, format: :svg) %>">
          <button type="button" class="<%= secondary_button_class %>" data-action="clipboard#copyText">Copiar link</button>
          <button type="button" class="<%= secondary_button_class %>" data-action="clipboard#copyImage">Copiar QR</button>
          <%= link_to "Descargar QR", whatsapp_qr_property_path(@property, format: :svg, download: 1), class: primary_button_class %>
        </div>
      <% else %>
        <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          Configurá TWILIO_WHATSAPP_FROM o WHATSAPP_FROM_NUMBER para generar links y QR reales.
        </div>
      <% end %>
    </div>

    <% unless @property_read_only %>
      <div class="<%= card_class %> p-5">
        <h3 class="text-base font-semibold text-slate-950">Reutilizar contenido de otra propiedad</h3>
        <p class="mt-1 text-sm text-slate-500">Copiá guías, FAQs, recomendaciones, datos de estadía o etiquetas a esta propiedad.</p>
        <% if @source_properties.any? %>
          <%= form_with url: copy_content_property_path(@property), method: :post, class: "mt-4 space-y-4" do %>
            <div>
              <%= label_tag :source_property_id, "Copiar desde", class: label_class %>
              <%= select_tag :source_property_id, options_from_collection_for_select(@source_properties, :id, :display_name), include_blank: "Elegir propiedad", class: field_class %>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <% [["guides", "Contenido estructurado y electrodomésticos"], ["recommendations", "Recomendaciones"], ["faqs", "FAQs"], ["settings", "Datos de estadía y notas de IA"], ["tags", "Etiquetas"]].each do |value, label| %>
                <label class="flex items-center gap-3 rounded-lg border border-slate-200 p-3 text-sm font-medium text-slate-700">
                  <%= check_box_tag "content_types[]", value, value.in?(%w[guides recommendations faqs]), class: "h-4 w-4 rounded border-slate-300 text-slate-900" %>
                  <%= label %>
                </label>
              <% end %>
            </div>
            <%= submit_tag "Copiar contenido seleccionado", class: primary_button_class %>
          <% end %>
        <% else %>
          <p class="mt-4 text-sm text-slate-500">Primero creá otra propiedad para reutilizar contenido acá.</p>
        <% end %>
      </div>
    <% end %>
  </section>

  <section id="overview" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="<%= card_class %> p-4">
      <p class="text-sm text-slate-500">Check-in</p>
      <p class="mt-2 text-lg font-semibold text-slate-950"><%= @property.check_in_time.presence || "Sin configurar" %></p>
    </div>
    <div class="<%= card_class %> p-4">
      <p class="text-sm text-slate-500">Checkout</p>
      <p class="mt-2 text-lg font-semibold text-slate-950"><%= @property.checkout_time.presence || "Sin configurar" %></p>
    </div>
    <div class="<%= card_class %> p-4">
      <p class="text-sm text-slate-500">WiFi</p>
      <p class="mt-2 text-lg font-semibold text-slate-950"><%= @property.wifi_name.presence || "Sin configurar" %></p>
    </div>
    <div class="<%= card_class %> p-4">
      <p class="text-sm text-slate-500">Consultas pendientes</p>
      <p class="mt-2 text-lg font-semibold text-slate-950"><%= @property.alerts.unknown_questions.open.count %></p>
    </div>
  </section>

  <section id="property-information" class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="text-base font-semibold text-slate-950">Información completa de la propiedad</h3>
      <p class="mt-1 text-sm text-slate-500">Todo lo configurado para esta propiedad y disponible para su operación.</p>
    </div>

    <div class="grid gap-6 p-5 xl:grid-cols-2">
      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Datos básicos</h4>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Nombre</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.name.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Alias interno</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.internal_nickname.presence || "Sin configurar" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Dirección</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.address.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Estado</dt>
            <dd class="mt-1 text-sm text-slate-700"><%= enum_label(@property.status) %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Ayla activa</dt>
            <dd class="mt-1 text-sm text-slate-700"><%= @property.ai_enabled? ? "Sí" : "No" %></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Etiquetas</dt>
            <dd class="mt-1 text-sm text-slate-700"><%= @property.tags.presence&.to_sentence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Co-host</h4>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Nombre</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.co_host&.name.presence || "Sin co-host" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">WhatsApp</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.co_host&.whatsapp_number.presence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Llegada y check-in</h4>
        <dl class="mt-4 grid gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Horario de check-in</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.check_in_time.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Instrucciones de acceso</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.access_instructions.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Estacionamiento</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.parking_instructions.presence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Durante la estadía</h4>
        <dl class="mt-4 grid gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Nombre de WiFi</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.wifi_name.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Contraseña de WiFi</dt>
            <dd class="mt-1 whitespace-pre-line break-all font-mono text-sm text-slate-700"><%= @property.wifi_password.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Notas útiles para responder</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.ai_general_notes.presence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Reglas, seguridad y escalamiento</h4>
        <dl class="mt-4 grid gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Reglas de la casa</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.house_rules.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Información de emergencia</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.emergency_information.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Cuándo consultar al propietario</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.owner_contact_instructions.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Teléfono de contacto del anfitrión</dt>
            <dd class="mt-1 break-words text-sm text-slate-700"><%= @property.owner_contact_phone.presence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-slate-200 p-4">
        <h4 class="font-semibold text-slate-950">Checkout</h4>
        <dl class="mt-4 grid gap-4">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Horario de checkout</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.checkout_time.presence || "Sin configurar" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Instrucciones de salida</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-sm text-slate-700"><%= @property.checkout_instructions.presence || "Sin configurar" %></dd>
          </div>
        </dl>
      </div>

      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 xl:col-span-2">
        <h4 class="font-semibold text-amber-950">Datos sensibles guardados</h4>
        <p class="mt-1 text-sm text-amber-800">Códigos, ubicaciones de llaves y contraseñas que Ayla puede consultar cuando el huésped está autorizado.</p>
        <% if @sensitive_data.any? %>
          <dl class="mt-4 grid gap-4 md:grid-cols-2">
            <% @sensitive_data.each do |datum| %>
              <div class="rounded-lg border border-amber-200 bg-white p-3">
                <dt class="text-xs font-semibold uppercase tracking-wide text-amber-700"><%= enum_label(datum.kind) %></dt>
                <dd class="mt-1 whitespace-pre-line break-all font-mono text-sm text-slate-800"><%= datum.value.presence || "Sin valor disponible" %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-4 text-sm text-amber-800">No hay datos sensibles adicionales guardados.</p>
        <% end %>
      </div>
    </div>
  </section>

  <section id="knowledge" class="<%= card_class %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <div>
        <h3 class="text-base font-semibold text-slate-950">Guías, información y electrodomésticos</h3>
        <p class="text-sm text-slate-500">Todo el contenido estructurado que Ayla puede consultar para responder.</p>
      </div>
      <% unless @property_read_only %>
        <%= link_to "Agregar guía", new_property_knowledge_block_path(@property, category: "appliances"), class: secondary_button_class %>
      <% end %>
    </div>
    <div class="divide-y divide-slate-100">
      <% @knowledge_blocks.each do |guide| %>
        <div class="px-5 py-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-medium text-slate-950"><%= guide.title %></p>
              <p class="mt-1 text-sm text-slate-500"><%= enum_label(guide.category) %> · <%= enum_label(guide.status) %></p>
            </div>
            <% unless @property_read_only %>
              <%= link_to "Editar", edit_property_knowledge_block_path(@property, guide), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
            <% end %>
          </div>
          <p class="mt-3 whitespace-pre-line break-words text-sm text-slate-600"><%= guide.content %></p>
          <% if guide.youtube_url.present? %>
            <p class="mt-3 text-sm"><%= link_to "Video de YouTube", guide.youtube_url, target: "_blank", rel: "noopener", class: "font-semibold text-slate-700 hover:text-slate-950" %></p>
          <% end %>
        </div>
      <% end %>
      <% if @knowledge_blocks.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">Todavía no hay guías ni contenido estructurado.</p>
      <% end %>
    </div>
  </section>

  <section id="recommendations" class="<%= card_class %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <div>
        <h3 class="text-base font-semibold text-slate-950">Recomendaciones locales</h3>
        <p class="text-sm text-slate-500">Lugares aprobados por el anfitrión para comida, básicos, transporte y visitas.</p>
      </div>
      <% unless @property_read_only %>
        <%= link_to "Agregar lugar", new_property_recommendation_path(@property), class: secondary_button_class %>
      <% end %>
    </div>
    <div class="grid gap-4 p-5 md:grid-cols-2">
      <% @recommendations.each do |recommendation| %>
        <div class="rounded-lg border border-slate-200 p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-medium text-slate-950"><%= recommendation.name %></p>
              <p class="mt-1 text-sm text-slate-500"><%= enum_label(recommendation.category) %> · <%= recommendation.active? ? "Activa" : "Inactiva" %></p>
            </div>
            <% unless @property_read_only %>
              <div class="flex items-center gap-3">
                <%= link_to "Editar", edit_property_recommendation_path(@property, recommendation), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
                <%= button_to "Eliminar", property_recommendation_path(@property, recommendation), method: :delete, class: "text-sm font-semibold text-rose-600 hover:text-rose-700" %>
              </div>
            <% end %>
          </div>
          <dl class="mt-4 grid gap-3 text-sm">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Descripción</dt>
              <dd class="mt-1 whitespace-pre-line break-words text-slate-600"><%= recommendation.description.presence || "Sin configurar" %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Nota del propietario</dt>
              <dd class="mt-1 whitespace-pre-line break-words text-slate-600"><%= recommendation.owner_note.presence || "Sin configurar" %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Dirección</dt>
              <dd class="mt-1 break-words text-slate-600"><%= recommendation.address.presence || "Sin configurar" %></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Distancia o tiempo caminando</dt>
              <dd class="mt-1 break-words text-slate-600"><%= recommendation.distance_or_walking_time.presence || "Sin configurar" %></dd>
            </div>
            <% if recommendation.phone_number.present? %>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Teléfono</dt>
                <dd class="mt-1 break-words text-slate-600"><%= recommendation.phone_number %></dd>
              </div>
            <% end %>
            <% if recommendation.google_maps_url.present? || recommendation.website_url.present? %>
              <div class="flex flex-wrap gap-3">
                <% if recommendation.google_maps_url.present? %>
                  <%= link_to "Abrir en Google Maps", recommendation.google_maps_url, target: "_blank", rel: "noopener", class: "font-semibold text-slate-700 hover:text-slate-950" %>
                <% end %>
                <% if recommendation.website_url.present? %>
                  <%= link_to "Abrir sitio web", recommendation.website_url, target: "_blank", rel: "noopener", class: "font-semibold text-slate-700 hover:text-slate-950" %>
                <% end %>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
      <% if @recommendations.blank? %>
        <p class="text-sm text-slate-500">No hay recomendaciones configuradas.</p>
      <% end %>
    </div>
  </section>

  <section id="faqs" class="<%= card_class %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <div>
        <h3 class="text-base font-semibold text-slate-950">FAQs</h3>
        <p class="text-sm text-slate-500">Respuestas reutilizables para preguntas frecuentes de huéspedes.</p>
      </div>
      <% unless @property_read_only %>
        <div class="flex flex-wrap justify-end gap-2">
          <%= link_to "Agregar FAQ", new_property_faq_path(@property), class: secondary_button_class %>
          <%= link_to "Agregar en varias propiedades", bulk_new_property_faqs_path(@property), class: secondary_button_class %>
        </div>
      <% end %>
    </div>
    <div class="divide-y divide-slate-100">
      <% @faqs.each do |faq| %>
        <div class="px-5 py-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-medium text-slate-950"><%= faq.question %></p>
              <p class="mt-1 text-xs text-slate-500"><%= faq.category.presence || "Sin categoría" %> · <%= enum_label(faq.status) %> · <%= faq.active? ? "Activa" : "Inactiva" %></p>
            </div>
            <% unless @property_read_only %>
              <%= link_to "Editar", edit_property_faq_path(@property, faq), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
            <% end %>
          </div>
          <p class="mt-2 whitespace-pre-line break-words text-sm text-slate-600"><%= faq.answer %></p>
          <p class="mt-2 text-xs text-slate-400">Origen: <%= enum_label(faq.source_type) %></p>
        </div>
      <% end %>
      <% if @faqs.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">Todavía no hay FAQs.</p>
      <% end %>
    </div>
  </section>

  <section id="new-questions" class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="text-base font-semibold text-slate-950">Consultas pendientes</h3>
      <p class="mt-1 text-sm text-slate-500">Preguntas que la IA no supo responder. Si no requieren una acción física, guardá la respuesta como FAQ para que la IA la use la próxima vez.</p>
    </div>
    <div class="divide-y divide-slate-100">
      <% @new_questions.each do |alert| %>
        <div class="px-5 py-4">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="font-medium text-slate-950"><%= alert.description.presence || alert.title %></p>
              <p class="mt-1 text-sm text-slate-500"><%= alert.guest&.display_name || "Huésped desconocido" %> · <%= local_datetime(alert.created_at) %></p>
            </div>
            <% if alert.conversation.present? %>
              <%= link_to "Ver conversación", conversation_path(alert.conversation), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
            <% end %>
          </div>
          <% unless @property_read_only %>
            <%= form_with url: answer_question_alert_path(alert), method: :post, class: "mt-4 grid gap-3" do |form| %>
              <div>
                <%= label_tag "faq_question_#{alert.id}", "Pregunta", class: label_class %>
                <%= text_area_tag "faq[question]", alert.description.presence || alert.title, id: "faq_question_#{alert.id}", rows: 2, class: field_class, required: true %>
              </div>
              <div>
                <%= label_tag "faq_answer_#{alert.id}", "Respuesta reusable", class: label_class %>
                <%= text_area_tag "faq[answer]", nil, id: "faq_answer_#{alert.id}", rows: 4, class: field_class, required: true, placeholder: "Escribí la respuesta que la IA podrá reutilizar para esta propiedad." %>
              </div>
              <div class="flex justify-end">
                <%= form.submit "Guardar como FAQ", class: primary_button_class %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% if @new_questions.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">No hay consultas pendientes en esta propiedad.</p>
      <% end %>
    </div>
  </section>

  <% unless @property_read_only %>
    <section id="settings" class="<%= card_class %> p-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-base font-semibold text-slate-950">Configuración</h3>
          <p class="mt-1 text-sm text-slate-500">Archivá la propiedad desde la pantalla de edición o actualizá las notas de IA arriba.</p>
        </div>
        <%= link_to "Editar configuración", edit_property_path(@property), class: secondary_button_class %>
      </div>
    </section>
  <% end %>
</div>
