<% content_for :page_title, "Nueva propiedad" %>

<div class="mx-auto max-w-5xl">
  <% if @source_properties.any? %>
    <div class="<%= card_class %> mb-6 p-5">
      <h3 class="text-base font-semibold text-slate-950">Empezar desde otra propiedad</h3>
      <p class="mt-1 text-sm text-slate-500">Reutilizá etiquetas, datos de estadía y notas de IA como punto de partida.</p>
      <%= form_with url: new_property_path, method: :get, class: "mt-4 grid gap-3 md:grid-cols-[1fr_auto]" do %>
        <%= select_tag :copy_from_id, options_from_collection_for_select(@source_properties, :id, :display_name, params[:copy_from_id]), include_blank: "Elegir propiedad", class: field_class %>
        <%= submit_tag "Usar como plantilla", class: secondary_button_class %>
      <% end %>
    </div>
  <% end %>
  <%= render "form", property: @property %>
</div>
