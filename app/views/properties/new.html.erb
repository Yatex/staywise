<% content_for :page_title, "New property" %>

<div class="mx-auto max-w-5xl">
  <div class="mb-6">
    <%= link_to "Back to properties", properties_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Create a property</h2>
    <p class="mt-1 text-sm text-slate-500">Add the core stay details the AI should rely on when guests write through WhatsApp.</p>
  </div>
  <% if @source_properties.any? %>
    <div class="<%= card_class %> mb-6 p-5">
      <h3 class="text-base font-semibold text-slate-950">Start from another property</h3>
      <p class="mt-1 text-sm text-slate-500">Reuse tags, stay details, and AI notes as a starting point.</p>
      <%= form_with url: new_property_path, method: :get, class: "mt-4 grid gap-3 md:grid-cols-[1fr_auto]" do %>
        <%= select_tag :copy_from_id, options_from_collection_for_select(@source_properties, :id, :display_name, params[:copy_from_id]), include_blank: "Choose property", class: field_class %>
        <%= submit_tag "Use as template", class: secondary_button_class %>
      <% end %>
    </div>
  <% end %>
  <%= render "form", property: @property %>
</div>
