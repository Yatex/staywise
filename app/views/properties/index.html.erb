<% content_for :page_title, "Properties" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-950">Properties</h2>
      <p class="mt-1 text-sm text-slate-500">Each property has its own guest guide, recommendations, FAQs, and conversations.</p>
    </div>
    <%= link_to "Add property", new_property_path, class: primary_button_class %>
  </div>

  <%= form_with url: properties_path, method: :get, class: "#{card_class} grid gap-4 p-4 md:grid-cols-[1fr_180px_180px_auto]" do |form| %>
    <div>
      <%= form.label :q, "Search", class: label_class %>
      <%= form.search_field :q, value: params[:q], class: field_class, placeholder: "Name, nickname, or address" %>
    </div>
    <div>
      <%= form.label :status, class: label_class %>
      <%= form.select :status, [["All", "all"]] + Property::STATUSES.map { |status| [status.humanize, status] }, { selected: params[:status].presence || "all" }, class: field_class %>
    </div>
    <div>
      <%= form.label :tag, class: label_class %>
      <%= form.select :tag, [["All tags", ""]] + @available_tags.map { |tag| [tag, tag] }, { selected: params[:tag] }, class: field_class %>
    </div>
    <div class="flex items-end gap-2">
      <%= form.submit "Filter", class: primary_button_class %>
      <%= link_to "Clear", properties_path, class: secondary_button_class %>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @properties.each do |property| %>
      <% whatsapp_link = Whatsapp::PropertyDeepLink.call(property) %>
      <article class="<%= card_class %> p-5 transition hover:border-slate-300 hover:shadow-md">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-semibold text-slate-950"><%= property.display_name %></p>
            <p class="mt-1 text-sm text-slate-500"><%= property.name %></p>
          </div>
          <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(property.status) %>"><%= property.status.humanize %></span>
        </div>
        <p class="mt-4 text-sm text-slate-500"><%= property.address.presence || "No address configured" %></p>
        <% if property.tags.any? %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% property.tags.each do |tag| %>
              <%= link_to tag, properties_path(tag: tag), class: "rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200 hover:bg-slate-200" %>
            <% end %>
          </div>
        <% end %>
        <div class="mt-5 grid grid-cols-3 gap-2 text-center">
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-lg font-semibold text-slate-950"><%= property.knowledge_blocks.count %></p>
            <p class="text-xs text-slate-500">Guide</p>
          </div>
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-lg font-semibold text-slate-950"><%= property.recommendations.count %></p>
            <p class="text-xs text-slate-500">Places</p>
          </div>
          <div class="rounded-lg bg-slate-50 p-3">
            <p class="text-lg font-semibold text-slate-950"><%= property.alerts.open.count %></p>
            <p class="text-xs text-slate-500">Alerts</p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4" data-controller="clipboard" data-clipboard-text-value="<%= whatsapp_link %>" data-clipboard-url-value="<%= whatsapp_qr_property_path(property, format: :svg) %>">
          <%= link_to "Open", property_path(property), class: primary_button_class %>
          <button type="button" class="<%= secondary_button_class %>" data-action="clipboard#copyText">Copy WhatsApp link</button>
          <button type="button" class="<%= secondary_button_class %>" data-action="clipboard#copyImage">Copy QR</button>
          <%= link_to "Download QR", whatsapp_qr_property_path(property, format: :svg, download: 1), class: secondary_button_class %>
        </div>
      </article>
    <% end %>
  </div>

  <% if @properties.blank? %>
    <div class="<%= card_class %> p-8 text-center">
      <h3 class="text-lg font-semibold text-slate-950">Add your first property</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">Start with the practical stay information guests ask for most: access, WiFi, checkout, and local help.</p>
      <%= link_to "Create property", new_property_path, class: "#{primary_button_class} mt-5" %>
    </div>
  <% end %>
</div>
