<% content_for :page_title, t("ui.properties.title") %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-950"><%= t("ui.properties.title") %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= t("ui.properties.subtitle") %></p>
    </div>
    <%= link_to t("ui.properties.add"), new_property_path, class: primary_button_class %>
  </div>

  <%= form_with url: properties_path, method: :get, class: "#{card_class} grid gap-4 p-4 md:grid-cols-2 xl:grid-cols-[minmax(260px,1fr)_160px_180px_210px_auto]" do |form| %>
    <div>
      <%= form.label :q, t("ui.actions.search"), class: label_class %>
      <%= form.search_field :q, value: params[:q], class: field_class, placeholder: t("ui.properties.search_placeholder") %>
    </div>
    <div>
      <%= form.label :status, class: label_class %>
      <%= form.select :status, [[t("ui.common.all"), "all"]] + Property::STATUSES.map { |status| [enum_label(status), status] }, { selected: params[:status].presence || "all" }, class: field_class %>
    </div>
    <div>
      <%= form.label :tag, class: label_class %>
      <%= form.select :tag, [[t("ui.properties.all_tags"), ""]] + @available_tags.map { |tag| [tag, tag] }, { selected: params[:tag] }, class: field_class %>
    </div>
    <div>
      <%= form.label :co_host_id, t("ui.properties.co_host_filter"), class: label_class %>
      <%= form.select :co_host_id,
        [[t("ui.properties.all_co_hosts"), ""], [t("ui.properties.without_co_host"), "none"]] + @available_co_hosts.map { |co_host| [co_host.name, co_host.id] },
        { selected: params[:co_host_id] }, class: field_class %>
    </div>
    <div class="flex items-end gap-2">
      <%= form.submit t("ui.actions.filter"), class: primary_button_class %>
      <%= link_to t("ui.actions.clear"), properties_path, class: secondary_button_class %>
    </div>
  <% end %>

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @properties.each do |property| %>
      <% whatsapp_link = Whatsapp::PropertyDeepLink.call(property) %>
      <article class="<%= card_class %> flex h-full flex-col p-5 transition hover:border-slate-300 hover:shadow-md">
        <p class="text-lg font-semibold text-slate-950"><%= property.display_name %></p>
        <% unless property_editable?(property) %>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400"><%= property.account.name %></p>
        <% end %>
        <p class="mt-2 text-sm text-slate-500"><%= property.address.presence || t("ui.properties.no_address") %></p>
        <% if property.tags.any? %>
          <div class="mt-3 flex flex-wrap gap-2">
            <% property.tags.each do |tag| %>
              <%= link_to tag, properties_path(tag: tag), class: "rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200 hover:bg-slate-200" %>
            <% end %>
          </div>
        <% end %>
        <% if property.co_host.present? %>
          <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5">
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700"><%= t("ui.properties.co_host_label") %></p>
            <%= link_to property.co_host.name, properties_path(co_host_id: property.co_host_id), class: "mt-0.5 block truncate text-sm font-semibold text-slate-950 hover:text-emerald-700" %>
          </div>
        <% elsif !property_editable?(property) %>
          <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5">
            <p class="text-sm font-semibold text-amber-900"><%= t("ui.properties.no_co_host") %></p>
          </div>
        <% else %>
          <details class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5">
            <summary class="cursor-pointer list-none text-sm font-semibold text-amber-900 marker:hidden">
              <span class="flex items-center justify-between gap-3">
                <span><%= t("ui.properties.no_co_host") %></span>
                <span class="shrink-0 text-xs"><%= t("ui.properties.add_co_host") %> +</span>
              </span>
            </summary>
            <div class="mt-3 space-y-3 border-t border-amber-200 pt-3">
              <% if @known_co_hosts.any? %>
                <%= form_with url: co_host_property_path(property), method: :patch, class: "space-y-2" do %>
                  <%= label_tag "co_host_id_#{property.id}", t("ui.properties.choose_existing_co_host"), class: "block text-xs font-semibold text-slate-700" %>
                  <div class="grid gap-2">
                    <%= select_tag :co_host_id,
                      options_for_select(@known_co_hosts.map { |co_host| ["#{co_host.name} · #{co_host.whatsapp_number}", co_host.id] }),
                      id: "co_host_id_#{property.id}", class: "w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm", required: true, include_blank: true %>
                    <%= submit_tag t("ui.properties.assign_existing_co_host"), class: "#{primary_button_class} w-full" %>
                  </div>
                <% end %>
                <p class="text-center text-xs font-medium text-amber-800"><%= t("ui.properties.or_create_co_host") %></p>
              <% end %>
              <%= form_with url: co_host_property_path(property), method: :patch, scope: :property, class: "grid gap-2" do |co_host_form| %>
                <%= co_host_form.text_field :co_host_name, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm", placeholder: t("ui.properties.co_host_name"), required: true %>
                <%= co_host_form.telephone_field :co_host_phone_number, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm", placeholder: t("ui.properties.co_host_phone"), required: true %>
                <%= co_host_form.submit t("ui.properties.save_co_host"), class: secondary_button_class %>
              <% end %>
            </div>
          </details>
        <% end %>
        <div class="mt-auto flex flex-wrap gap-2 border-t border-slate-100 pt-4" data-controller="clipboard" data-clipboard-text-value="<%= whatsapp_link %>">
          <%= link_to t("ui.actions.open"), property_path(property), class: primary_button_class %>
          <% if whatsapp_link.present? %>
            <button type="button" class="<%= secondary_button_class %>" data-action="clipboard#copyText"><%= t("ui.properties.copy_whatsapp_link") %></button>
            <%= link_to t("ui.properties.download_qr"), whatsapp_qr_property_path(property, format: :svg, download: 1), class: secondary_button_class %>
          <% else %>
            <span class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900"><%= t("ui.properties.whatsapp_not_configured") %></span>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>

  <% if @properties.blank? %>
    <div class="<%= card_class %> p-8 text-center">
      <h3 class="text-lg font-semibold text-slate-950"><%= t("ui.properties.empty_title") %></h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-500"><%= t("ui.properties.empty_body") %></p>
      <%= link_to t("ui.properties.create"), new_property_path, class: "#{primary_button_class} mt-5" %>
    </div>
  <% end %>

  <% if @total_pages.to_i > 1 %>
    <div class="flex items-center justify-between">
      <p class="text-sm text-slate-500">Página <%= @current_page %> de <%= @total_pages %></p>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "Anterior", properties_path(request.query_parameters.merge(page: @current_page - 1)), class: secondary_button_class %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Siguiente", properties_path(request.query_parameters.merge(page: @current_page + 1)), class: secondary_button_class %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
