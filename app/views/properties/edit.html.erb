<% content_for :page_title, "Editar propiedad" %>

<div class="mx-auto max-w-5xl">
  <div class="mb-6">
    <%= link_to "Volver a la propiedad", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Editar <%= @property.display_name %></h2>
  </div>
  <%= render "form", property: @property %>
</div>
