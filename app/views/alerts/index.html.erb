<% content_for :page_title, t("ui.nav.alerts") %>

<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-slate-950"><%= t("ui.alerts.title") %></h2>
    <p class="mt-1 text-sm text-slate-500"><%= t("ui.alerts.subtitle") %></p>
  </div>

  <div class="<%= card_class %> overflow-hidden">
    <div class="divide-y divide-slate-100">
      <% @alerts.each do |alert| %>
        <div class="px-5 py-4 transition hover:bg-slate-50">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <%= link_to alert_path(alert), class: "block" do %>
                <p class="font-medium text-slate-950"><%= alert_display_title(alert) %></p>
                <p class="mt-1 text-sm text-slate-500"><%= alert.property.display_name %> · <%= alert.guest&.display_name || t("ui.alerts.unknown_guest") %></p>
                <% if alert_display_description(alert).present? %>
                  <p class="mt-2 line-clamp-2 text-sm text-slate-600"><%= alert_display_description(alert) %></p>
                <% end %>
              <% end %>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-2">
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(alert.status) %>"><%= enum_label(alert.status) %></span>
              <% if alert.status == "open" %>
                <%= button_to alert_path(alert),
                  method: :patch,
                  params: { alert: { status: "resolved" } },
                  class: "inline-flex h-9 w-9 items-center justify-center rounded-md border border-emerald-200 bg-white text-emerald-700 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2",
                  title: t("ui.alerts.mark_done"),
                  aria: { label: t("ui.alerts.mark_done") } do %>
                  <span class="sr-only"><%= t("ui.alerts.mark_done") %></span>
                  <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 20 20" fill="none">
                    <path d="M4.5 10.5 8 14l7.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% if @alerts.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500"><%= t("ui.alerts.empty") %></p>
      <% end %>
    </div>
  </div>

  <% if @total_pages.to_i > 1 %>
    <div class="flex items-center justify-between">
      <p class="text-sm text-slate-500">Página <%= @current_page %> de <%= @total_pages %></p>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "Anterior", alerts_path(request.query_parameters.merge(page: @current_page - 1)), class: secondary_button_class %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Siguiente", alerts_path(request.query_parameters.merge(page: @current_page + 1)), class: secondary_button_class %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
