<% content_for :page_title, t("ui.nav.alerts") %>

<div class="space-y-6">
  <div>
    <h2 class="text-xl font-semibold text-slate-950"><%= t("ui.alerts.title") %></h2>
    <p class="mt-1 text-sm text-slate-500"><%= t("ui.alerts.subtitle") %></p>
  </div>

  <div class="<%= card_class %> overflow-hidden">
    <div class="divide-y divide-slate-100">
      <% @alerts.each do |alert| %>
        <div class="px-5 py-4 transition hover:bg-slate-50">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <%= link_to alert_path(alert), class: "block" do %>
                <p class="font-medium text-slate-950"><%= alert_display_title(alert) %></p>
                <p class="mt-1 text-sm text-slate-500"><%= alert.property.display_name %> · <%= alert.guest&.display_name || t("ui.alerts.unknown_guest") %></p>
                <% if alert_display_description(alert).present? %>
                  <p class="mt-2 line-clamp-2 text-sm text-slate-600"><%= alert_display_description(alert) %></p>
                <% end %>
              <% end %>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-2">
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(alert.priority) %>"><%= enum_label(alert.priority) %></span>
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(alert.status) %>"><%= enum_label(alert.status) %></span>
              <% if alert.status.in?(%w[open in_progress]) %>
                <%= button_to t("ui.alerts.mark_done"), alert_path(alert), method: :patch, params: { alert: { status: "resolved" } }, class: "rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% if @alerts.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500"><%= t("ui.alerts.empty") %></p>
      <% end %>
    </div>
  </div>
</div>
