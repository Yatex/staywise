<% content_for :page_title, @alert.title %>

<div class="mx-auto max-w-4xl space-y-6">
  <section class="<%= card_class %> p-5">
    <%= link_to "Back to alerts", alerts_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-slate-950"><%= @alert.title %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= @alert.alert_type.humanize %> · <%= @alert.property.display_name %></p>
      </div>
      <span class="w-fit rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@alert.priority) %>"><%= @alert.priority.humanize %></span>
    </div>

    <div class="mt-6 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Description</p>
      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= @alert.description.presence || "No description provided." %></p>
    </div>

    <div class="mt-4 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">AI suggested action</p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= @alert.ai_suggested_action.presence || "Review the conversation and respond." %></p>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Update task</h3>
    <%= form_with model: @alert, class: "mt-4 grid gap-4 md:grid-cols-[1fr_1fr_auto]" do |form| %>
      <div>
        <%= form.label :status, class: label_class %>
        <%= form.select :status, Alert::STATUSES.map { |status| [status.humanize, status] }, {}, class: field_class %>
      </div>
      <div>
        <%= form.label :priority, class: label_class %>
        <%= form.select :priority, Alert::PRIORITIES.map { |priority| [priority.humanize, priority] }, {}, class: field_class %>
      </div>
      <div class="flex items-end">
        <%= form.submit "Save", class: primary_button_class %>
      </div>
    <% end %>
  </section>

  <% if @alert.conversation.present? %>
    <%= link_to "Open conversation", conversation_path(@alert.conversation), class: secondary_button_class %>
  <% end %>
</div>
