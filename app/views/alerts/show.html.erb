<% content_for :page_title, alert_display_title(@alert) %>

<div class="mx-auto max-w-4xl space-y-6">
  <section class="<%= card_class %> p-5">
    <%= link_to "Volver a alertas", alerts_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-slate-950"><%= alert_display_title(@alert) %></h2>
        <p class="mt-2 text-sm text-slate-500"><%= enum_label(@alert.alert_type) %> · <%= @alert.property.display_name %></p>
      </div>
      <span class="w-fit rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@alert.priority) %>"><%= enum_label(@alert.priority) %></span>
    </div>

    <div class="mt-6 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Descripción</p>
      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600"><%= @alert.description.presence || "Sin descripción." %></p>
    </div>

    <div class="mt-4 rounded-lg bg-slate-50 p-4">
      <p class="text-sm font-semibold text-slate-900">Acción sugerida por IA</p>
      <p class="mt-2 text-sm leading-6 text-slate-600"><%= @alert.ai_suggested_action.presence || "Revisá la conversación y respondé al huésped." %></p>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Actualizar tarea</h3>
    <%= form_with model: @alert, class: "mt-4 grid gap-4 md:grid-cols-[1fr_1fr_auto]" do |form| %>
      <div>
        <%= form.label :status, class: label_class %>
        <%= form.select :status, Alert::STATUSES.map { |status| [enum_label(status), status] }, {}, class: field_class %>
      </div>
      <div>
        <%= form.label :priority, class: label_class %>
        <%= form.select :priority, Alert::PRIORITIES.map { |priority| [enum_label(priority), priority] }, {}, class: field_class %>
      </div>
      <div class="flex items-end">
        <%= form.submit "Guardar", class: primary_button_class %>
      </div>
    <% end %>
  </section>

  <% if @alert.conversation.present? %>
    <%= link_to "Abrir conversación", conversation_path(@alert.conversation), class: secondary_button_class %>
  <% end %>
</div>
