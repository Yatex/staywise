<% content_for :page_title, "AI Trace" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-950">AI Trace</h2>
      <p class="mt-1 text-sm text-slate-500">Trazabilidad interna de decisiones, tools, evidencia, validaciones y envíos de WhatsApp.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Errores recientes", admin_errors_path, class: secondary_button_class %>
      <%= link_to "Estadísticas", admin_stats_path, class: secondary_button_class %>
    </div>
  </div>

  <%= form_with url: admin_ai_traces_path, method: :get, class: "#{card_class} grid gap-4 p-4 md:grid-cols-[1fr_1fr_1fr_1fr] xl:grid-cols-[120px_1fr_160px_150px_130px_130px_150px_auto]" do |form| %>
    <div>
      <%= form.label :conversation_id, "Conversación", class: label_class %>
      <%= form.number_field :conversation_id, value: params[:conversation_id], class: field_class, placeholder: "ID" %>
    </div>
    <div>
      <%= form.label :property_id, "Propiedad", class: label_class %>
      <%= form.select :property_id,
        options_from_collection_for_select(@properties, :id, :display_name, params[:property_id]),
        { include_blank: "Todas" },
        class: field_class %>
    </div>
    <div>
      <%= form.label :decision, "Decisión", class: label_class %>
      <%= form.select :decision,
        options_for_select(@decisions, params[:decision]),
        { include_blank: "Todas" },
        class: field_class %>
    </div>
    <div>
      <%= form.label :tool, "Tool", class: label_class %>
      <%= form.select :tool,
        options_for_select(@tools, params[:tool]),
        { include_blank: "Todas" },
        class: field_class %>
    </div>
    <div>
      <%= form.label :from, "Desde", class: label_class %>
      <%= form.date_field :from, value: params[:from], class: field_class %>
    </div>
    <div>
      <%= form.label :to, "Hasta", class: label_class %>
      <%= form.date_field :to, value: params[:to], class: field_class %>
    </div>
    <div class="space-y-3 pt-1">
      <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <%= check_box_tag :fallback, "1", params[:fallback].present?, class: "h-4 w-4 rounded border-slate-300" %>
        Con fallback
      </label>
      <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <%= check_box_tag :validation_failed, "1", params[:validation_failed].present?, class: "h-4 w-4 rounded border-slate-300" %>
        Validación fallida
      </label>
    </div>
    <div class="flex items-end gap-2">
      <%= form.submit "Filtrar", class: primary_button_class %>
      <%= link_to "Limpiar", admin_ai_traces_path, class: secondary_button_class %>
    </div>
  <% end %>

  <section class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <p class="text-sm font-semibold text-slate-950"><%= pluralize(@total_count, "traza", "trazas") %></p>
    </div>

    <div class="divide-y divide-slate-100">
      <% @traces.each do |trace| %>
        <% payload = trace.payload.to_h %>
        <% tool_names = trace.tool_calls.map { |tool| tool["tool_name"] || tool["toolName"] }.compact.uniq %>
        <%= link_to admin_ai_trace_path(trace, query_params.except("page")), class: "block px-5 py-4 transition hover:bg-slate-50" do %>
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(trace.final_outcome || trace.decision) %>"><%= trace.final_outcome || trace.decision || "Sin decisión" %></span>
                <% if trace.fallback? %>
                  <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">Fallback</span>
                <% end %>
                <% if trace.validation_failed? %>
                  <span class="rounded-full bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-700 ring-1 ring-rose-200">Validación fallida</span>
                <% end %>
              </div>
              <p class="mt-3 text-base font-semibold text-slate-950"><%= trace.original_message&.body || trace.message&.body || "Mensaje no disponible" %></p>
              <p class="mt-2 text-sm text-slate-500">
                <%= trace.property&.display_name || "Propiedad sin asociar" %>
                · Conversación #<%= trace.conversation_id || "sin ID" %>
                · <%= local_datetime(trace.created_at) %>
              </p>
              <% if tool_names.any? %>
                <p class="mt-2 text-xs text-slate-500">Tools: <%= tool_names.join(", ") %></p>
              <% end %>
            </div>
            <div class="text-sm text-slate-500 lg:text-right">
              <p>Idioma: <span class="font-medium text-slate-800"><%= trace.language.presence || "sin detectar" %></span></p>
              <p>Evidence: <span class="font-medium text-slate-800"><%= Array(trace.evidence_ids).size %></span></p>
              <p>WhatsApp: <span class="font-medium text-slate-800"><%= payload.dig("whatsapp_delivery", "delivery_status") || trace.provider_delivery_status || "sin datos" %></span></p>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @traces.blank? %>
        <div class="px-5 py-10 text-center text-sm text-slate-500">No hay trazas con esos filtros.</div>
      <% end %>
    </div>
  </section>

  <% if @total_pages > 1 %>
    <div class="flex items-center justify-between">
      <p class="text-sm text-slate-500">Página <%= @current_page %> de <%= @total_pages %></p>
      <div class="flex gap-2">
        <% if @current_page > 1 %>
          <%= link_to "Anterior", admin_ai_traces_path(query_params.merge(page: @current_page - 1)), class: secondary_button_class %>
        <% end %>
        <% if @current_page < @total_pages %>
          <%= link_to "Siguiente", admin_ai_traces_path(query_params.merge(page: @current_page + 1)), class: secondary_button_class %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
