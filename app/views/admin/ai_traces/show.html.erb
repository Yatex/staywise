<% content_for :page_title, "AI Trace ##{@trace.id}" %>

<% payload = @trace.payload.to_h %>
<% validation = @trace.validation_results.presence || payload["validation_results"].presence || {} %>
<% evidence_trace = payload["evidence_trace"].presence || validation.to_h["evidence"].presence || [] %>
<% alert_trace = payload["alert"].presence || { "created" => false } %>
<% whatsapp_trace = payload["whatsapp_delivery"].presence || {} %>
<% original_decision = payload["original_decision"].presence || payload["rejected_candidate"].presence || @trace.ai_response_payload.to_h %>
<% generated_response = original_decision.to_h["response_text"].presence || original_decision.to_h["message_body"].presence || payload["outcome"].presence %>
<% safe_fallback_response = payload["safe_fallback_response"].presence || @trace.ai_response_payload.to_h["safe_fallback_response"].presence || payload["rejected_candidate"].to_h["safe_fallback_response"].presence %>
<% final_response = payload["final_response_text"].presence %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <%= link_to "Volver a AI Trace", admin_ai_traces_path(query_params.except("page")), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
      <h2 class="mt-2 text-xl font-semibold text-slate-950">AI Trace #<%= @trace.id %></h2>
      <p class="mt-1 text-sm text-slate-500">Detalle interno sanitizado. No contiene headers de autorización ni secretos en claro.</p>
    </div>
    <div class="flex gap-2">
      <% if @trace.conversation.present? %>
        <%= link_to "Ver conversación", conversation_path(@trace.conversation), class: secondary_button_class %>
      <% end %>
      <% if @trace.property.present? %>
        <%= link_to "Ver propiedad", property_path(@trace.property), class: secondary_button_class %>
      <% end %>
    </div>
  </div>

  <section class="<%= card_class %> p-5">
    <div class="grid gap-4 md:grid-cols-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Decisión final</p>
        <p class="mt-1 text-lg font-semibold text-slate-950"><%= @trace.final_outcome || @trace.decision || "Sin decisión" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Idioma detectado</p>
        <p class="mt-1 text-lg font-semibold text-slate-950"><%= @trace.language.presence || "Sin datos" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Ruta</p>
        <p class="mt-1 text-lg font-semibold text-slate-950"><%= @trace.route %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Latencia</p>
        <p class="mt-1 text-lg font-semibold text-slate-950"><%= @trace.latency_ms.present? ? "#{@trace.latency_ms} ms" : "Sin datos" %></p>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Mensaje original del huésped</h3>
    <p class="mt-3 whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= @trace.original_message&.body || @trace.message&.body || "Mensaje no disponible" %></p>
    <div class="mt-4 flex flex-wrap gap-2 text-xs text-slate-500">
      <span>Cuenta: <%= @trace.account&.name || "Sin cuenta" %></span>
      <span>· Propiedad: <%= @trace.property&.display_name || "Sin propiedad" %></span>
      <span>· Conversación: #<%= @trace.conversation_id || "sin ID" %></span>
      <span>· Correlación: <%= payload["correlation_id"].presence || "Sin datos" %></span>
      <span>· <%= local_datetime(@trace.created_at) %></span>
    </div>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Intenciones detectadas</h3>
    <% if @trace.detected_intents.present? %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% @trace.detected_intents.each do |intent| %>
          <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200"><%= intent.is_a?(Hash) ? intent.values_at("type", "status").compact.join(" · ") : intent %></span>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No se registraron intenciones.</p>
    <% end %>
    <details class="mt-4 rounded-lg border border-slate-200 p-3">
      <summary class="cursor-pointer text-sm font-semibold text-slate-700">Ver JSON</summary>
      <pre class="mt-3 overflow-auto text-xs text-slate-700"><%= trace_json(@trace.detected_intents) %></pre>
    </details>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Tool Requests</h3>
    <p class="mt-1 text-sm text-slate-500">Contexto resuelto por Rails, request exacto, respuesta sanitizada completa y evidencia asociada a cada ejecución.</p>
    <% if @trace.tool_calls.present? %>
      <div class="mt-4 space-y-4">
        <% @trace.tool_calls.each do |tool| %>
          <% tool = tool.to_h %>
          <% tool_context = tool["context"].to_h %>
          <% tool_request = tool["request"].presence || tool["input"].presence || {} %>
          <% tool_response = tool.key?("response") ? tool["response"] : tool["output_summary"] %>
          <% returned_evidence = Array(tool["evidence_returned"]) %>
          <% referenced_evidence = Array(tool["evidence_referenced"]) %>
          <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <div class="flex flex-col gap-2 border-b border-slate-200 bg-slate-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-2">
                <span class="font-mono text-sm font-semibold text-slate-950"><%= tool["tool_name"] || tool["toolName"] || "tool" %></span>
                <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= tool["error"].present? ? "bg-rose-100 text-rose-700" : "bg-emerald-100 text-emerald-700" %>"><%= tool["error"].present? ? "Error" : "OK" %></span>
              </div>
              <p class="text-xs text-slate-500">
                <%= tool["timestamp"] || tool["called_at"] || "Sin timestamp" %>
                · <%= tool["latency_ms"].present? ? "#{tool["latency_ms"]} ms" : "Sin latencia" %>
              </p>
            </div>

            <div class="space-y-5 p-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Contexto resuelto por Rails</p>
                <% if tool_context.present? %>
                  <dl class="mt-2 grid gap-3 rounded-lg bg-slate-50 p-3 text-sm sm:grid-cols-2 xl:grid-cols-4">
                    <div><dt class="text-xs text-slate-500">Conversation ID</dt><dd class="font-semibold text-slate-900"><%= tool_context["conversation_id"] || "Sin datos" %></dd></div>
                    <div><dt class="text-xs text-slate-500">Reservation ID</dt><dd class="font-semibold text-slate-900"><%= tool_context["reservation_id"].presence || "Sin reserva" %></dd></div>
                    <div><dt class="text-xs text-slate-500">Property</dt><dd class="font-semibold text-slate-900"><%= tool_context["property_name"] || "Sin datos" %> · ID <%= tool_context["property_id"] || "N/A" %></dd></div>
                    <div><dt class="text-xs text-slate-500">Account</dt><dd class="font-semibold text-slate-900"><%= tool_context["account_name"] || "Sin datos" %> · ID <%= tool_context["account_id"] || "N/A" %></dd></div>
                    <div class="sm:col-span-2 xl:col-span-4"><dt class="text-xs text-slate-500">Decision Context ID</dt><dd class="break-all font-mono text-xs font-semibold text-slate-900"><%= tool_context["decision_context_fingerprint"] || "Sin datos" %></dd></div>
                  </dl>
                <% else %>
                  <p class="mt-2 text-sm text-slate-500">Este trace es anterior a la captura de contexto por tool.</p>
                <% end %>
              </div>

              <div class="grid gap-4 lg:grid-cols-2">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Request de la AI</p>
                  <pre class="mt-2 max-h-80 overflow-auto rounded-lg bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(tool_request) %></pre>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Tool Response</p>
                  <details class="mt-2 rounded-lg border border-slate-200 p-3">
                    <summary class="cursor-pointer text-sm font-semibold text-slate-700">Ver respuesta completa</summary>
                    <pre class="mt-3 max-h-[36rem] overflow-auto rounded bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(tool_response) %></pre>
                  </details>
                </div>
              </div>

              <div>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Evidence returned · <%= returned_evidence.size %></p>
                  <p class="text-xs font-semibold text-indigo-700">Evidence referenced · <%= referenced_evidence.size %></p>
                </div>
                <% if returned_evidence.present? %>
                  <div class="mt-2 space-y-2">
                    <% returned_evidence.each do |evidence| %>
                      <% evidence = evidence.to_h %>
                      <details class="rounded-lg border border-slate-200 p-3">
                        <summary class="cursor-pointer list-none">
                          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                              <p class="font-mono text-xs font-semibold text-slate-900"><%= evidence["evidence_id"] || "Sin Evidence ID" %></p>
                              <p class="mt-1 text-sm font-semibold text-slate-950"><%= evidence["title"].presence || "Sin título" %></p>
                              <p class="mt-1 text-xs text-slate-500">
                                Tipo: <%= evidence["type"].presence || "N/A" %>
                                · Scope: <%= evidence["scope"].presence || "N/A" %>
                                · Property: <%= evidence["property_name"].presence || "N/A" %> (#<%= evidence["property_id"].presence || "N/A" %>)
                                · Account: <%= evidence["account_name"].presence || "N/A" %> (#<%= evidence["account_id"].presence || "N/A" %>)
                              </p>
                            </div>
                            <div class="flex shrink-0 flex-wrap gap-2">
                              <span class="rounded-full px-2 py-1 text-xs font-semibold <%= evidence["referenced"] ? "bg-indigo-100 text-indigo-700" : "bg-slate-100 text-slate-600" %>"><%= evidence["referenced"] ? "Referenced" : "Returned only" %></span>
                              <% unless evidence["validation_passed"].nil? %>
                                <span class="rounded-full px-2 py-1 text-xs font-semibold <%= evidence["validation_passed"] ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700" %>"><%= evidence["validation_passed"] ? "✓ Validada" : "✗ Rechazada" %></span>
                              <% end %>
                            </div>
                          </div>
                        </summary>
                        <div class="mt-3 border-t border-slate-100 pt-3">
                          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Contenido completo recibido por la AI</p>
                          <pre class="mt-2 max-h-[32rem] overflow-auto whitespace-pre-wrap rounded bg-slate-50 p-3 text-sm text-slate-800"><%= evidence["content"].presence || "Sin contenido" %></pre>
                          <p class="mt-3 text-sm <%= evidence["validation_passed"] == false ? "text-rose-700" : "text-slate-600" %>">
                            Validación Rails: <strong><%= evidence["validation_label"].presence || "Sin datos" %></strong>
                          </p>
                          <% if evidence["validation"].present? %>
                            <details class="mt-2">
                              <summary class="cursor-pointer text-xs font-semibold text-slate-600">Ver validación completa</summary>
                              <pre class="mt-2 overflow-auto rounded bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(evidence["validation"]) %></pre>
                            </details>
                          <% end %>
                        </div>
                      </details>
                    <% end %>
                  </div>
                <% else %>
                  <p class="mt-2 text-sm text-slate-500">La tool no devolvió evidencia catalogable o el trace es anterior a esta observabilidad.</p>
                <% end %>
              </div>

              <details class="rounded-lg border border-slate-200 p-3">
                <summary class="cursor-pointer text-xs font-semibold text-slate-600">Ver registro completo de la tool</summary>
                <pre class="mt-2 max-h-[40rem] overflow-auto rounded bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(tool) %></pre>
              </details>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No se registraron tools para esta decisión.</p>
    <% end %>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Evidence referenced</h3>
    <p class="mt-1 text-sm text-slate-500">Evidencia citada por la decisión final y validada por Rails.</p>
    <% if evidence_trace.present? %>
      <div class="mt-4 overflow-hidden rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-3 py-2">Evidence ID</th>
              <th class="px-3 py-2">Fuente</th>
              <th class="px-3 py-2">Scope</th>
              <th class="px-3 py-2">Propiedad</th>
              <th class="px-3 py-2">Cuenta</th>
              <th class="px-3 py-2">Procedencia Rails</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% evidence_trace.each do |evidence| %>
              <% evidence = evidence.to_h %>
              <tr>
                <td class="px-3 py-3 font-mono text-xs text-slate-800"><%= evidence["evidence_id"] || evidence[:evidence_id] %></td>
                <td class="max-w-sm px-3 py-3 text-slate-600">
                  <span class="font-medium"><%= evidence["source"] || evidence[:source] || "Sin fuente" %></span><br>
                  <span class="text-xs">campo: <%= evidence["field"] || evidence[:field] || "Sin campo" %></span><br>
                  <span class="text-xs">valor: <%= trace_evidence_value(evidence) %></span>
                </td>
                <td class="px-3 py-3 text-slate-600"><%= evidence["scope"] || evidence[:scope] || "Sin scope" %></td>
                <td class="px-3 py-3 text-slate-600">
                  conversación: <%= evidence["conversation_property_id"] || evidence[:conversation_property_id] || payload["conversation_property_id"] || @trace.property_id %><br>
                  evidencia: <%= evidence["evidence_property_id"] || evidence[:evidence_property_id] || "N/A" %>
                </td>
                <td class="px-3 py-3 text-slate-600">
                  conversación: <%= evidence["conversation_account_id"] || evidence[:conversation_account_id] || payload["conversation_account_id"] || @trace.account_id %><br>
                  evidencia: <%= evidence["evidence_account_id"] || evidence[:evidence_account_id] || "N/A" %>
                </td>
                <td class="px-3 py-3 text-slate-600">
                  autorizada: <%= (evidence["authorized"].nil? ? evidence[:authorized] : evidence["authorized"]).nil? ? "sin datos" : (evidence["authorized"].nil? ? evidence[:authorized] : evidence["authorized"]) %><br>
                  motivo: <%= evidence["provenance_reason"] || evidence[:provenance_reason] || "sin observaciones" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No se registró evidencia.</p>
    <% end %>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Respuesta y validaciones</h3>
    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Decisión original de la AI</p>
        <p class="mt-2 whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= generated_response.presence || "Sin respuesta generada" %></p>
        <p class="mt-2 text-xs text-slate-500">Acción: <%= original_decision.to_h["action"] || original_decision.to_h["outcome"] || "Sin datos" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Fallback seguro del AI</p>
        <p class="mt-2 whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= safe_fallback_response.presence || "No provisto" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Respuesta final de Rails</p>
        <p class="mt-2 whitespace-pre-line rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= final_response.presence || "No se envió respuesta" %></p>
      </div>
      <div class="lg:col-span-3">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Validaciones Rails</p>
        <div class="mt-2 rounded-lg bg-slate-50 p-4 text-sm text-slate-800">
          <p>Resultado: <strong><%= validation.to_h["status"] || @trace.validator_result || "Sin datos" %></strong></p>
          <p class="mt-1">Acción: <strong><%= payload["rails_fallback_source"].presence || "respuesta principal" %></strong></p>
          <p class="mt-1">Idioma: <strong><%= payload["fallback_language"].presence || @trace.language.presence || "Sin datos" %></strong></p>
          <% reasons = validation.to_h["reasons"].presence || Array(@trace.rejection_reason) %>
          <% if reasons.present? %>
            <ul class="mt-2 list-disc pl-5">
              <% Array(reasons).each do |reason| %>
                <li><%= reason %></li>
              <% end %>
            </ul>
          <% end %>
          <% warnings = validation.to_h["warnings"] %>
          <% if warnings.present? %>
            <p class="mt-3 font-semibold text-amber-700">Advertencias no bloqueantes</p>
            <ul class="mt-1 list-disc pl-5 text-amber-700">
              <% Array(warnings).each do |warning| %>
                <li><%= warning %></li>
              <% end %>
            </ul>
          <% end %>
          <% owner_task_result = payload.to_h.dig("guest_request", "operational_result") %>
          <% if owner_task_result.present? %>
            <p class="mt-3 font-semibold text-slate-950">Resultado operativo</p>
            <p class="mt-1"><%= owner_task_result %></p>
            <% if (created_owner_task_id = payload.to_h.dig("guest_request", "created_owner_task_id")).present? %>
              <p class="mt-1">created_owner_task_id: <strong><%= created_owner_task_id %></strong></p>
            <% end %>
            <% if (updated_owner_task_id = payload.to_h.dig("guest_request", "updated_owner_task_id")).present? %>
              <p class="mt-1">updated_owner_task_id: <strong><%= updated_owner_task_id %></strong></p>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <details class="mt-4 rounded-lg border border-slate-200 p-3">
      <summary class="cursor-pointer text-sm font-semibold text-slate-700">Ver request/response JSON</summary>
      <div class="mt-3 grid gap-4 lg:grid-cols-2">
        <pre class="overflow-auto rounded bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(@trace.ai_request_payload) %></pre>
        <pre class="overflow-auto rounded bg-slate-950 p-3 text-xs text-slate-100"><%= trace_json(@trace.ai_response_payload) %></pre>
      </div>
    </details>
  </section>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Fallback, alerta y WhatsApp</h3>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg bg-slate-50 p-4 text-sm">
        <p class="font-semibold text-slate-950">Fallback</p>
        <p class="mt-2 text-slate-600"><%= @trace.fallback_reason.presence || "No aplicado" %></p>
      </div>
      <div class="rounded-lg bg-slate-50 p-4 text-sm">
        <p class="font-semibold text-slate-950">Alerta</p>
        <p class="mt-2 text-slate-600">Creada: <%= alert_trace["created"] ? "sí" : "no" %></p>
        <% if alert_trace["created"] %>
          <p class="text-slate-600">Tipo: <%= alert_trace["type"] %></p>
          <p class="text-slate-600">Estado: <%= alert_trace["status"] %></p>
          <p class="text-slate-600">Visible owner: <%= alert_trace["visible_for_owner"] ? "sí" : "no" %></p>
        <% end %>
      </div>
      <div class="rounded-lg bg-slate-50 p-4 text-sm">
        <p class="font-semibold text-slate-950">WhatsApp</p>
        <p class="mt-2 text-slate-600">Enviado: <%= whatsapp_trace["sent"] ? "sí" : "no" %></p>
        <p class="text-slate-600">Delivery: <%= whatsapp_trace["delivery_status"] || @trace.provider_delivery_status || "Sin datos" %></p>
        <% if whatsapp_trace["provider_error"].present? %>
          <p class="text-rose-700">Error: <%= whatsapp_trace["provider_error"] %></p>
        <% end %>
      </div>
    </div>
  </section>

  <% if @trace.checkin_trace.present? %>
    <section class="<%= card_class %> p-5 ring-2 ring-indigo-100">
      <h3 class="text-base font-semibold text-slate-950">CHECKIN_TRACE</h3>
      <pre class="mt-4 overflow-auto rounded bg-slate-950 p-4 text-xs text-slate-100"><%= trace_json(@trace.checkin_trace) %></pre>
    </section>
  <% end %>

  <section class="<%= card_class %> p-5">
    <h3 class="text-base font-semibold text-slate-950">Payload completo sanitizado</h3>
    <details class="mt-4 rounded-lg border border-slate-200 p-3">
      <summary class="cursor-pointer text-sm font-semibold text-slate-700">Ver JSON</summary>
      <pre class="mt-3 overflow-auto rounded bg-slate-950 p-4 text-xs text-slate-100"><%= trace_json(payload) %></pre>
    </details>
  </section>
</div>
