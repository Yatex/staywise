<% content_for :page_title, "Estadísticas admin" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-950">Estadísticas de plataforma</h2>
      <p class="mt-1 text-sm text-slate-500">Uso global de Ayla Manager, suscripciones y actividad de IA.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Gestionar usuarios", admin_users_path, class: secondary_button_class %>
      <%= link_to "Errores recientes", admin_errors_path, class: secondary_button_class %>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% [
      ["Usuarios totales", @total_users],
      ["Cuentas pagas", @paying_accounts],
      ["Suscripciones pagas activas", @paying_subscriptions],
      ["Propiedades totales", @total_properties],
      ["Huéspedes", @total_guests],
      ["Conversaciones", @total_conversations],
      ["Alertas abiertas", @open_alerts],
      ["Errores abiertos", @open_operational_errors],
      ["Errores críticos", @critical_operational_errors],
      ["Mensajes de IA", @ai_messages]
    ].each do |label, value| %>
      <div class="<%= card_class %> p-4">
        <p class="text-sm text-slate-500"><%= label %></p>
        <p class="mt-3 text-3xl font-semibold text-slate-950"><%= value %></p>
      </div>
    <% end %>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="<%= card_class %> overflow-hidden">
      <div class="border-b border-slate-200 px-5 py-4">
        <h3 class="text-base font-semibold text-slate-950">Planes pagos activos</h3>
      </div>
      <table class="min-w-full divide-y divide-slate-100 text-sm">
        <tbody class="divide-y divide-slate-100">
          <% Subscription::PLANS.each do |plan| %>
            <tr>
              <td class="px-5 py-3 font-medium text-slate-900"><%= enum_label(plan) %></td>
              <td class="px-5 py-3 text-right text-slate-600"><%= @paid_subscriptions_by_plan[plan] || 0 %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="<%= card_class %> overflow-hidden">
      <div class="border-b border-slate-200 px-5 py-4">
        <h3 class="text-base font-semibold text-slate-950">Suscripciones por estado</h3>
      </div>
      <table class="min-w-full divide-y divide-slate-100 text-sm">
        <tbody class="divide-y divide-slate-100">
          <% Subscription::STATUSES.each do |status| %>
            <tr>
              <td class="px-5 py-3">
                <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(status) %>"><%= enum_label(status) %></span>
              </td>
              <td class="px-5 py-3 text-right text-slate-600"><%= @subscriptions_by_status[status] || 0 %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-3">
    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Usuarios por rol</h3>
      <div class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between"><span class="text-slate-500">Administradores</span><strong><%= @admin_users %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Propietarios</span><strong><%= @owner_users %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Miembros</span><strong><%= @member_users %></strong></div>
      </div>
    </div>

    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Estado de suscripciones</h3>
      <div class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between"><span class="text-slate-500">En prueba</span><strong><%= @trialing_subscriptions %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Pago vencido</span><strong><%= @past_due_subscriptions %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Canceladas</span><strong><%= @canceled_subscriptions %></strong></div>
      </div>
    </div>

    <div class="<%= card_class %> p-5">
      <h3 class="text-base font-semibold text-slate-950">Estado de conversaciones</h3>
      <div class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between"><span class="text-slate-500">Conversaciones activas</span><strong><%= @active_conversations %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Alertas abiertas</span><strong><%= @open_alerts %></strong></div>
        <div class="flex justify-between"><span class="text-slate-500">Mensajes de IA</span><strong><%= @ai_messages %></strong></div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="<%= card_class %> overflow-hidden">
      <div class="border-b border-slate-200 px-5 py-4">
        <h3 class="text-base font-semibold text-slate-950">Alertas por tipo</h3>
      </div>
      <div class="divide-y divide-slate-100">
        <% @alerts_by_type.each do |type, count| %>
          <div class="flex items-center justify-between px-5 py-3 text-sm">
            <span class="font-medium text-slate-900"><%= enum_label(type) %></span>
            <span class="text-slate-500"><%= count %></span>
          </div>
        <% end %>
        <% if @alerts_by_type.blank? %>
          <p class="px-5 py-8 text-sm text-slate-500">Todavía no hay alertas.</p>
        <% end %>
      </div>
    </div>

    <div class="<%= card_class %> overflow-hidden">
      <div class="border-b border-slate-200 px-5 py-4">
        <h3 class="text-base font-semibold text-slate-950">Registros recientes</h3>
      </div>
      <div class="divide-y divide-slate-100">
        <% @recent_signups.each do |user| %>
          <div class="px-5 py-3 text-sm">
            <p class="font-medium text-slate-950"><%= user.email %></p>
            <p class="mt-1 text-xs text-slate-500"><%= user.account.name %> · <%= local_datetime(user.created_at) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="text-base font-semibold text-slate-950">Eventos recientes de suscripción</h3>
    </div>
    <div class="divide-y divide-slate-100">
      <% @recent_billing_events.each do |event| %>
        <div class="flex items-center justify-between gap-4 px-5 py-3 text-sm">
          <div>
            <p class="font-medium text-slate-950"><%= event.event_type %></p>
            <p class="mt-1 text-xs text-slate-500"><%= event.account&.name || "Cuenta desconocida" %></p>
          </div>
          <span class="text-xs text-slate-400"><%= local_datetime(event.created_at) %></span>
        </div>
      <% end %>
      <% if @recent_billing_events.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">Todavía no hay eventos de suscripción.</p>
      <% end %>
    </div>
  </section>

  <section class="<%= card_class %> overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <h3 class="text-base font-semibold text-slate-950">Errores operativos recientes</h3>
      <%= link_to "Ver todos", admin_errors_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
    </div>
    <div class="divide-y divide-slate-100">
      <% @recent_operational_errors.each do |error| %>
        <div class="flex items-start justify-between gap-4 px-5 py-3 text-sm">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(error.severity) %>"><%= enum_label(error.severity) %></span>
              <span class="font-medium text-slate-950"><%= enum_label(error.source) %></span>
            </div>
            <p class="mt-2 text-slate-600"><%= truncate(error.message, length: 140) %></p>
            <p class="mt-1 text-xs text-slate-500"><%= error.account&.name || "Sin cuenta" %> · <%= error.property&.display_name || error.property&.name || "Sin propiedad" %></p>
          </div>
          <%= link_to "Ver", admin_error_path(error), class: secondary_button_class %>
        </div>
      <% end %>
      <% if @recent_operational_errors.blank? %>
        <p class="px-5 py-8 text-sm text-slate-500">No hay errores abiertos.</p>
      <% end %>
    </div>
  </section>
</div>
