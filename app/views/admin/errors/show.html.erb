<% content_for :page_title, "Detalle de error" %>

<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <%= link_to "Volver a errores", admin_errors_path(params.permit(:q, :source, :severity, :status, :page)), class: "text-sm font-semibold text-slate-500 hover:text-slate-900" %>
      <h2 class="mt-3 text-xl font-semibold text-slate-950">Detalle de error</h2>
      <p class="mt-1 text-sm text-slate-500"><%= @error.created_at.to_fs(:long) %></p>
    </div>
    <% unless @error.resolved? %>
      <%= button_to "Marcar como resuelto", resolve_admin_error_path(@error, params.permit(:q, :source, :severity, :status, :page)), method: :patch, class: primary_button_class %>
    <% end %>
  </div>

  <section class="<%= card_class %> p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@error.severity) %>"><%= enum_label(@error.severity) %></span>
      <span class="rounded-full px-2 py-1 text-xs font-semibold ring-1 <%= pill_class(@error.resolved? ? "resolved" : "open") %>"><%= @error.resolved? ? "Resuelto" : "Abierto" %></span>
      <span class="text-sm font-medium text-slate-500"><%= enum_label(@error.source) %></span>
    </div>

    <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-slate-500">Mensaje</dt>
        <dd class="mt-1 whitespace-pre-wrap text-slate-950"><%= @error.message %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500">Clase</dt>
        <dd class="mt-1 text-slate-950"><%= @error.error_class.presence || "Sin clase" %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500">Cuenta</dt>
        <dd class="mt-1 text-slate-950"><%= @error.account&.name || "Sin cuenta" %></dd>
      </div>
      <div>
        <dt class="font-medium text-slate-500">Propiedad</dt>
        <dd class="mt-1 text-slate-950"><%= @error.property&.display_name || @error.property&.name || "Sin propiedad" %></dd>
      </div>
      <% if @error.resolved? %>
        <div>
          <dt class="font-medium text-slate-500">Resuelto</dt>
          <dd class="mt-1 text-slate-950"><%= @error.resolved_at.to_fs(:long) %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="<%= card_class %> overflow-hidden">
    <div class="border-b border-slate-200 px-5 py-4">
      <h3 class="text-base font-semibold text-slate-950">Contexto</h3>
    </div>
    <pre class="max-h-[520px] overflow-auto bg-slate-950 p-5 text-xs leading-6 text-slate-100"><%= JSON.pretty_generate(@error.context || {}) %></pre>
  </section>
</div>
