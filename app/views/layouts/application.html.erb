<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:page_title).presence || "Ayla Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "ayla-favicon.svg", type: "image/svg+xml" %>
    <link rel="apple-touch-icon" type="image/png" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 font-sans text-slate-950 antialiased">
    <% if authenticated? %>
      <div class="min-h-screen lg:flex" data-controller="sidebar">
        <%= render "shared/sidebar" %>

        <div class="min-w-0 flex-1 transition-[padding] duration-200 lg:pl-72" data-sidebar-target="content">
          <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
            <div class="flex min-h-16 items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= current_account.name %></p>
                <h1 class="text-lg font-semibold text-slate-950"><%= content_for(:page_title).presence || "Ayla Manager" %></h1>
              </div>
              <div class="flex items-center gap-3">
                <div class="flex rounded-lg border border-slate-200 bg-white p-1 text-xs font-semibold text-slate-500 shadow-sm">
                  <% I18n.available_locales.each do |locale| %>
                    <%= link_to locale_label(locale),
                      locale_path(locale),
                      class: "rounded-md px-2 py-1 #{I18n.locale == locale ? "bg-slate-900 text-white" : "hover:bg-slate-50 hover:text-slate-900"}" %>
                  <% end %>
                </div>
                <%= link_to t("ui.layout.new_property"), new_property_path, class: secondary_button_class %>
                <details class="relative">
                  <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 text-left shadow-sm transition hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-900 text-xs font-bold text-white">
                      <%= (current_user.name.presence || current_user.email).first.upcase %>
                    </span>
                    <span class="hidden min-w-0 sm:block">
                      <span class="block max-w-44 truncate text-sm font-semibold text-slate-900"><%= current_user.name.presence || current_user.email %></span>
                      <span class="block max-w-44 truncate text-xs text-slate-500"><%= current_user.email %></span>
                    </span>
                    <span class="text-xs text-slate-400">v</span>
                  </summary>

                  <div class="absolute right-0 z-30 mt-2 w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
                    <div class="border-b border-slate-100 px-4 py-3">
                      <p class="truncate text-sm font-semibold text-slate-950"><%= current_user.name.presence || current_user.email %></p>
                      <p class="mt-1 truncate text-xs text-slate-500"><%= current_user.email %></p>
                    </div>
                    <nav class="p-2">
                      <%= link_to t("ui.nav.subscriptions"), subscription_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-950" %>
                      <%= link_to t("ui.nav.settings"), settings_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-950" %>
                    </nav>
                    <div class="border-t border-slate-100 p-2">
                      <%= button_to t("ui.layout.logout"), logout_path, method: :delete, class: "block w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-slate-500 transition hover:bg-slate-50 hover:text-slate-950" %>
                    </div>
                  </div>
                </details>
              </div>
            </div>
          </header>

          <main class="px-4 py-6 sm:px-6 lg:px-8">
            <%= render "shared/flash" %>
            <%= render "shared/trial_banner" %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="fixed right-4 top-4 z-20 flex rounded-lg border border-slate-200 bg-white p-1 text-xs font-semibold text-slate-500 shadow-sm">
        <% I18n.available_locales.each do |locale| %>
          <%= link_to locale_label(locale),
            locale_path(locale),
            class: "rounded-md px-2 py-1 #{I18n.locale == locale ? "bg-slate-900 text-white" : "hover:bg-slate-50 hover:text-slate-900"}" %>
        <% end %>
      </div>
      <main class="flex min-h-screen items-center justify-center px-4 py-12">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
