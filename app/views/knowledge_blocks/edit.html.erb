<% content_for :page_title, "Edit guide block" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Back to property", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Edit guide block</h2>
  </div>
  <%= render "form", property: @property, knowledge_block: @knowledge_block %>
  <div class="mt-4 text-right">
    <%= button_to "Delete block", property_knowledge_block_path(@property, @knowledge_block), method: :delete, class: "text-sm font-semibold text-rose-600 hover:text-rose-700" %>
  </div>
</div>
