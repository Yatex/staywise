<% content_for :page_title, "Nuevo bloque de guía" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <%= link_to "Volver a la propiedad", property_path(@property), class: "text-sm font-semibold text-slate-500 hover:text-slate-950" %>
    <h2 class="mt-3 text-xl font-semibold text-slate-950">Agregar bloque de guía</h2>
    <p class="mt-1 text-sm text-slate-500">Este contenido pasa a formar parte de la base de conocimiento de IA de la propiedad.</p>
  </div>
  <%= render "shared/source_selector",
    sources: @source_knowledge_blocks,
    url: new_property_knowledge_block_path(@property),
    title: "Reusar un bloque de guía",
    description: "Empezá con un bloque de guía de otra propiedad y ajustalo para esta estadía.",
    label: ->(block) { "#{block.property.display_name} - #{block.title}" } %>
  <%= render "form", property: @property, knowledge_block: @knowledge_block %>
</div>
