# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
DATABASE_URL=
APP_HOST=http://localhost:3000

# WhatsApp provider
WHATSAPP_PROVIDER=null
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_OWNER_ESCALATION_NOTICE_CONTENT_SID=
TWILIO_OWNER_OBSERVER_NOTICE_CONTENT_SID=
WHATSAPP_FROM_NUMBER=

# AI service boundary
AI_SERVICE_URL=
# Shared secret: set the exact same value on the Rails and AI Render services.
AI_SERVICE_TOKEN=
# Public/internal Rails origin used by the AI service for /internal/ai/tools/*.
AI_TOOLS_BASE_URL=
# Required on the AI service in production; prefer Render's private HTTP address with its port.
RAILS_TOOLS_BASE_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5-mini
AI_TOOLS_ENABLED=true
AI_TOOL_FIRST_FLOW_ENABLED=true
AI_SAFE_ROUTER_ENABLED=true
AI_EVIDENCE_REQUIRED=true
AI_CONSERVATIVE_FALLBACK_ENABLED=true
AI_MIN_REPLY_CONFIDENCE=0.55
# Optional Rails override. Keep {{owner_phone}} where the configured host phone should appear.
AI_TECHNICAL_FALLBACK_MESSAGE=Estoy teniendo un inconveniente técnico temporal y no pude responder tu consulta. Si es urgente, podés comunicarte con el anfitrión al {{owner_phone}}.

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
